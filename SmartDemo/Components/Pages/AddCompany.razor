@page "/AddCompany"
@rendermode InteractiveServer

<div class="company-desktop-viewport" dir="rtl" @onclick="CloseAllPopups">

    <!-- Top Window Toolbar / Header -->
    <div class="company-window-topbar">
        <div class="topbar-right-actions">
            <button style="border:none; background-color:transparent;" type="button" class="nav-arrow-btn">
                <i class="bi bi-arrow-right"></i>
            </button>
            <button style="border:none; background-color:transparent;" type="button" class="nav-arrow-btn">
                <i class="bi bi-arrow-left"></i>
            </button>
            <button type="button" class="btn-topbar-action" @onclick="SaveCompany">
                <span class="ico">💾</span>
                <span>حفظ</span>
            </button>
            <button type="button" class="btn-topbar-action btn-delete-action" @onclick="DeleteCompany">
                <span class="ico text-danger">🗑️</span>
                <span class="text-danger">حذف</span>
            </button>
        </div>

        <div class="topbar-left-actions">
            <button type="button" class="btn-topbar-close-red" @onclick="CloseForm" title="إغلاق">✕</button>
        </div>
    </div>

    <!-- Main Form Workspace Canvas -->
    <div class="company-canvas-sheet" @onclick:stopPropagation>

        <!-- ================= SECTION 1: BASIC INFO & LOGO ================= -->
        <div class="section-master-row">

            <!-- 1. Far Right: Illustration & Status -->
            <div class="entity-illustration-block">
                <div class="illustration-graphic-box">
                    <span class="fs-1">🏢</span>
                </div>
                <div class="active-toggle-group">
                    <label class="switch-toggle-label">
                        <input type="checkbox" class="switch-input" @bind="companyData.IsActive" />
                        <span class="switch-slider"></span>
                    </label>
                    <span class="small text-muted fw-bold">نشط</span>
                </div>
                <div class="orange-indicator-line"></div>
            </div>

            <!-- 2. Middle-Right: Field Labels -->
            <div class="entity-labels-column">
                <div class="label-cell"><span class="form-lbl">إسم الشركة</span></div>
                <div class="label-cell"><span class="form-lbl">النشاط</span></div>
                <div class="label-cell"><span class="form-lbl">الشعار</span></div>
            </div>

            <!-- 3. Middle: Input Fields -->
            <div class="entity-inputs-column">
                <!-- Row 1: Company Name -->
                <div class="input-row-entry">
                    <input type="text" class="clean-input flex-1" @bind="companyData.CompanyName" />
                    <span class="req-star">*</span>
                </div>

                <!-- Row 2: Business Activity Dropdown -->
                <div class="input-row-entry pos-relative">
                    <div class="dropdown-anchor flex-1">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleActivityPopup">
                            <span class="combo-display-text">@companyData.Activity</span>
                            <div class="combo-icons-inside">
                                <span class="combo-arrow">▼</span>
                            </div>
                        </div>

                        @if (isActivityPopupOpen)
                        {
                            <div class="custom-table-popup activity-popup-size" @onclick:stopPropagation>
                                <div class="table-popup-header">
                                    <div class="col-name">الاسم</div>
                                    <div class="col-code">الكود</div>
                                </div>
                                <div class="table-popup-filter-bar">
                                    <div class="col-name text-center text-muted small">🔤</div>
                                    <div class="col-code text-center text-muted small">🔤</div>
                                </div>
                                <div class="table-popup-list">
                                    @foreach (var act in mockActivities)
                                    {
                                        <div class="table-popup-row @(companyData.Activity == act.Name ? "active-row" : "")"
                                             @onclick="() => SelectActivity(act.Name)">
                                            <div class="col-name">@act.Name</div>
                                            <div class="col-code">@act.Code</div>
                                        </div>
                                    }
                                </div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isActivityPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                    <span class="req-star">*</span>
                </div>

                <!-- Row 3: Slogan -->
                <div class="input-row-entry">
                    <input type="text" class="clean-input flex-1" @bind="companyData.Slogan" />
                </div>
            </div>

            <!-- 4. Far Left: Company Logo Box -->
            <div class="company-logo-upload-block">
                <div class="logo-square-preview">
                    <span class="logo-msg-text">No image data</span>
                </div>
                <span class="logo-caption-text">شعار الشركة</span>
            </div>

        </div>

        <div style="height: 18px;"></div>

        <!-- ================= UNIFIED FORM GRID: CONTINUOUS ROWS & CONTINUOUS BLUE LINE ================= -->
        <div class="section-form-grid">
            <div class="form-grid-labels-col">
                <div class="label-cell"><span class="form-lbl">البلد</span></div>
                <div class="label-cell"><span class="form-lbl">العملة</span></div>
                <div class="label-cell"><span class="form-lbl">الرقم الضريبي</span></div>
                <div class="label-cell"><span class="form-lbl">السجل التجاري</span></div>
                <div class="label-cell"><span class="form-lbl">أرضي - محمول</span></div>
                <div class="label-cell"><span class="form-lbl">الفاكس</span></div>
                <div class="label-cell"><span class="form-lbl">البريد الإلكتروني</span></div>
                <div class="label-cell"><span class="form-lbl">المحافظة</span></div>
                <div class="label-cell"><span class="form-lbl">المدينة</span></div>
                <div class="label-cell"><span class="form-lbl">الحي</span></div>
                <div class="label-cell"><span class="form-lbl">الشارع</span></div>
                <div class="label-cell"><span class="form-lbl">رقم المبنى</span></div>
                <div class="label-cell"><span class="form-lbl">الرقم البريدي</span></div>
                <div class="label-cell"><span class="form-lbl">المعالم الرئيسية</span></div>
            </div>

            <div class="form-grid-inputs-col">
                <!-- Country -->
                <div class="input-row-entry pos-relative">
                    <div class="dropdown-anchor flex-1">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCountryPopup">
                            <span class="combo-display-text">@companyData.Country</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>

                        @if (isCountryPopupOpen)
                        {
                            <div class="custom-table-popup country-popup-size" @onclick:stopPropagation>
                                <div class="table-popup-header">
                                    <div class="col-name">الاسم</div>
                                </div>
                                <div class="table-popup-list">
                                    @foreach (var c in mockCountries)
                                    {
                                        <div class="table-popup-row @(companyData.Country == c ? "active-row" : "")"
                                             @onclick="() => SelectCountry(c)">
                                            <div class="col-name">@c</div>
                                        </div>
                                    }
                                </div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isCountryPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                    <span class="req-star">*</span>
                </div>

                <!-- Currency Dual Combo -->
                <div class="input-row-entry pos-relative">
                    <div class="dual-currency-wrapper flex-1">
                        <div class="dropdown-anchor flex-1">
                            <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCurrencyPopup">
                                <span class="combo-display-text">@companyData.Currency</span>
                                <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                            </div>

                            @if (isCurrencyPopupOpen)
                            {
                                <div class="custom-table-popup currency-popup-size" @onclick:stopPropagation>
                                    <div class="table-popup-header">
                                        <div class="col-name">الاسم</div>
                                        <div class="col-code">الكود</div>
                                    </div>
                                    <div class="table-popup-list">
                                        @foreach (var cur in mockCurrencies)
                                        {
                                            <div class="table-popup-row @(companyData.Currency == cur.Name ? "active-row" : "")"
                                                 @onclick="() => SelectCurrency(cur.Name, cur.SubCurrency)">
                                                <div class="col-name">@cur.Name</div>
                                                <div class="col-code">@cur.Code</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="table-popup-footer">
                                        <button type="button" class="btn-table-close" @onclick="() => isCurrencyPopupOpen = false">✕</button>
                                        <span class="resizer-dots">⠿</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="dropdown-anchor sub-currency-anchor">
                            <div class="custom-combo-trigger">
                                <span class="combo-display-text">@companyData.SubCurrency</span>
                                <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                            </div>
                        </div>
                    </div>
                    <span class="req-star">*</span>
                </div>

                <!-- Tax Number -->
                <div class="input-row-entry">
                    <input type="text" class="clean-input flex-1" @bind="companyData.TaxNumber" />
                </div>

                <!-- Commercial Register -->
                <div class="input-row-entry">
                    <input type="text" class="clean-input flex-1" @bind="companyData.CommercialRegister" />
                </div>

                <!-- Phones -->
                <div class="input-row-entry d-flex gap-2">
                    <input type="text" class="clean-input flex-1" @bind="companyData.Landline" placeholder="أرضي" />
                    <input type="text" class="clean-input flex-1" @bind="companyData.Mobile" placeholder="محمول" />
                </div>

                <!-- Fax -->
                <div class="input-row-entry">
                    <input type="text" class="clean-input flex-1" @bind="companyData.Fax" />
                </div>

                <!-- Email -->
                <div class="input-row-entry">
                    <input type="email" class="clean-input flex-1" @bind="companyData.Email" />
                </div>

                <!-- Address Fields -->
                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.Governorate" /></div>
                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.City" /></div>
                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.District" /></div>
                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.Street" /></div>

                <div class="input-row-entry d-flex align-items-center gap-2">
                    <input type="text" class="clean-input flex-1" @bind="companyData.BuildingNo" />
                    <span class="small text-muted ms-1">رقم الشقة</span>
                    <input type="text" class="clean-input flex-1" @bind="companyData.ApartmentNo" />
                </div>

                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.PostalCode" /></div>
                <div class="input-row-entry"><input type="text" class="clean-input flex-1" @bind="companyData.Landmarks" /></div>
            </div>
            <div class="blue-indicator-line"></div>
        </div>

        <!-- Bottom Action Buttons -->
        <div class="form-bottom-actions-bar">
            <button type="button" class="btn-primary-custom px-5" @onclick="SaveCompany">حفظ</button>
            <button type="button" class="btn-primary-custom px-5" @onclick="CloseForm">إغلاق</button>
        </div>

    </div>
</div>

@code {
    private bool isActivityPopupOpen = false;
    private bool isCountryPopupOpen = false;
    private bool isCurrencyPopupOpen = false;

    public class ActivityItem { public string Code { get; set; } = ""; public string Name { get; set; } = ""; }
    public class CurrencyItem { public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string SubCurrency { get; set; } = ""; }

    private List<ActivityItem> mockActivities = new()
    {
        new() { Code = "0111", Name = "زراعة الحبوب والمحاصيل ( فيما عدا الارز ) والبقوليات والـ..." },
        new() { Code = "0112", Name = "زراعة الارز" },
        new() { Code = "0113", Name = "زراعة الخضر والبطيخ والجذور والدرنات" },
        new() { Code = "0114", Name = "زراعة قصب السكر" },
        new() { Code = "0115", Name = "زراعة التبغ" },
        new() { Code = "0116", Name = "زراعة المحاصيل ذات الالياف" }
    };

    private List<string> mockCountries = new() { "مدغشقر", "أفغانستان", "موريتانيا", "تايلاند", "تايوان", "السودان", "المغرب", "فيجي", "مصر", "المملكة العربية السعودية" };

    private List<CurrencyItem> mockCurrencies = new()
    {
        new() { Code = "EGP", Name = "جنيه مصري", SubCurrency = "قرش" },
        new() { Code = "AFN", Name = "أفغاني", SubCurrency = "بول" },
        new() { Code = "SAR", Name = "ريال سعودي", SubCurrency = "هللة" },
        new() { Code = "USD", Name = "دولار أمريكي", SubCurrency = "سنت" },
        new() { Code = "MGA", Name = "أرياري مدغشقري", SubCurrency = "إيرايمبيلانجا" },
        new() { Code = "MRU", Name = "أوقية موريتانية", SubCurrency = "خمس" },
        new() { Code = "THB", Name = "البات التايلندي", SubCurrency = "ساتانغ" },
        new() { Code = "TWD", Name = "الجديد في تايوان الدولار", SubCurrency = "سنت" },
        new() { Code = "SDG", Name = "الجنيه السوداني", SubCurrency = "قرش" },
        new() { Code = "MAD", Name = "الدرهم المغربي", SubCurrency = "سنتيم" }
    };

    private CompanyModel companyData = new()
    {
        CompanyName = "مجموعة الاستثمار الذكي",
        Activity = "زراعة الحبوب والمحاصيل ( فيما عدا الارز ) والبقوليات والـ...",
        Slogan = "نبني مستقبل التجارة الحديثة",
        Country = "مصر",
        Currency = "أرياري مدغشقري",
        SubCurrency = "إيرايمبيلانجا",
        TaxNumber = "100293847",
        CommercialRegister = "EG-554433",
        Landline = "0223456789",
        Mobile = "01098765432",
        Fax = "0223456780",
        Email = "contact@smartinvest.com",
        Governorate = "القاهرة",
        City = "التجمع الخامس",
        District = "المنطقة التجارية",
        Street = "شارع التسعين الشمالي",
        BuildingNo = "برج الماس 4",
        ApartmentNo = "مكتب 502",
        PostalCode = "11835",
        Landmarks = "بجوار الجامعة الأمريكية",
        IsActive = true
    };

    private void ToggleActivityPopup() { CloseAllPopups(); isActivityPopupOpen = !isActivityPopupOpen; }
    private void ToggleCountryPopup() { CloseAllPopups(); isCountryPopupOpen = !isCountryPopupOpen; }
    private void ToggleCurrencyPopup() { CloseAllPopups(); isCurrencyPopupOpen = !isCurrencyPopupOpen; }

    private void SelectActivity(string name) { companyData.Activity = name; isActivityPopupOpen = false; }
    private void SelectCountry(string name) { companyData.Country = name; isCountryPopupOpen = false; }
    private void SelectCurrency(string name, string subCur)
    {
        companyData.Currency = name;
        companyData.SubCurrency = subCur;
        isCurrencyPopupOpen = false;
    }

    private void CloseAllPopups()
    {
        isActivityPopupOpen = false;
        isCountryPopupOpen = false;
        isCurrencyPopupOpen = false;
    }

    private void SaveCompany() { }
    private void DeleteCompany() { }
    private void CloseForm() { }

    public class CompanyModel
    {
        public string CompanyName { get; set; } = "";
        public string Activity { get; set; } = "";
        public string Slogan { get; set; } = "";
        public string Country { get; set; } = "";
        public string Currency { get; set; } = "";
        public string SubCurrency { get; set; } = "";
        public string TaxNumber { get; set; } = "";
        public string CommercialRegister { get; set; } = "";
        public string Landline { get; set; } = "";
        public string Mobile { get; set; } = "";
        public string Fax { get; set; } = "";
        public string Email { get; set; } = "";
        public string Governorate { get; set; } = "";
        public string City { get; set; } = "";
        public string District { get; set; } = "";
        public string Street { get; set; } = "";
        public string BuildingNo { get; set; } = "";
        public string ApartmentNo { get; set; } = "";
        public string PostalCode { get; set; } = "";
        public string Landmarks { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
}

<style>
    .company-desktop-viewport {
        background-color: #f1f3f6;
        min-height: 100vh;
        width: 100%;
        padding: 15px 30px;
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        flex-direction: column;
    }

    /* Top Window Toolbar */
    .company-window-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #F1F3F8;
        padding: 0px 16px;
        border-radius: 6px 6px 0 0;
        border: 1px solid #dee2e6;
        max-width: 1080px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    .topbar-right-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .btn-topbar-action {
        background: transparent;
        border: 1px solid #ced4da;
        padding: 3px 12px;
        font-size: 0.82rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
        color: #495057;
        font-weight: 500;
        border-top: 0;
        border-bottom: 0;
    }

        .btn-topbar-action.btn-delete-action {
            border-radius: 0;
            border-right: 0;
        }

        .btn-topbar-action:hover {
            background-color: #f8f9fa;
            border-color: #adb5bd;
        }

    .btn-delete-action:hover {
        background-color: #fff5f5;
        border-color: #f5c6cb;
    }

    .btn-topbar-close-red {
        border: none;
        background: red;
        font-size: 10px;
        color: white;
        cursor: pointer;
    }

    .topbar-left-actions {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Canvas Sheet */
    .company-canvas-sheet {
        max-width: 1080px;
        margin: 0 auto;
        width: 100%;
        background-color: #f1f3f6;
        border-top: none;
        padding: 30px 40px;
        box-sizing: border-box;
    }

    /* Master Row: Illustration (Right), Labels, Inputs, Logo (Left) */
    .section-master-row {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 16px;
        position: relative;
    }

    /* 1. Illustration Block on Far Right */
    .entity-illustration-block {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-left: 14px;
        user-select: none;
        order: 1;
    }

    .illustration-graphic-box {
        width: 80px;
        height: 85px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 6px;
    }

    .orange-indicator-line {
        position: absolute;
        left: 0;
        top: 0;
        width: 3px;
        height: 100px;
        background-color: #e67e22;
        border-radius: 2px;
    }

    /* Switch Toggle Styling */
    .active-toggle-group {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .switch-toggle-label {
        position: relative;
        display: inline-block;
        width: 34px;
        height: 18px;
        margin: 0;
    }

    .switch-input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .switch-slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #ccc;
        transition: .2s;
        border-radius: 20px;
    }

        .switch-slider:before {
            position: absolute;
            content: "";
            height: 14px;
            width: 14px;
            left: 2px;
            bottom: 2px;
            background-color: white;
            transition: .2s;
            border-radius: 50%;
        }

    .switch-input:checked + .switch-slider {
        background-color: #007bff;
    }

        .switch-input:checked + .switch-slider:before {
            transform: translateX(16px);
        }

    /* 2. Labels Column */
    .entity-labels-column {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 2px;
        order: 2;
    }

    .label-cell {
        height: 31px;
        display: flex;
        align-items: center;
    }

    .form-lbl {
        font-size: 0.88rem;
        font-weight: 600;
        color: #333333;
        white-space: nowrap;
    }

    /* 3. Inputs Column */
    .entity-inputs-column {
        width: 440px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        order: 3;
    }

    .input-row-entry {
        display: flex;
        align-items: center;
        gap: 6px;
        min-height: 31px;
    }

    .flex-1 {
        flex: 1;
    }

    /* 4. Company Logo on Far Left */
    .company-logo-upload-block {
        margin-right: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        order: 4;
    }

    .logo-square-preview {
        width: 95px;
        height: 95px;
        border: 1px solid #ced4da;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        margin-bottom: 6px;
    }

    .logo-msg-text {
        font-size: 0.72rem;
        color: #868e96;
        text-align: center;
    }

    .logo-caption-text {
        font-size: 0.8rem;
        color: #495057;
    }

    /* Unified Form Grid: Uniform 8px Gap across All Fields */
    .section-form-grid {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        position: relative;
        padding-right: 14px;
    }

    .form-grid-labels-col {
        width: 110px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-grid-inputs-col {
        width: 440px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .blue-indicator-line {
        position: absolute;
        right: 0; /* Changed from left: 0 to anchor correctly to the right side of the grid in RTL mode */
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: #007bff;
        border-radius: 2px;
    }

    /* Clean Form Inputs */
    .clean-input {
        border: 1px solid #ced4da;
        border-radius: 3px;
        padding: 4px 10px;
        font-size: 0.85rem;
        background-color: #ffffff;
        outline: none;
        box-sizing: border-box;

    // ================= CALCULATOR POPUP LOGIC =================
    private string activeCalcField = "";
    private string alertMinLimit = "0";
    private string alertMaxLimit = "100";
    private string alertStagnantPeriod = "15";
    private string alertExpiryAlert = "30";
    private string alertInstallationFee = "0";

    private double calcOperand = 0;
    private string calcOperator = "";
    private bool calcNewNumber = true;

    private void ToggleCalculator(string fieldKey)
    {
        if (activeCalcField == fieldKey)
        {
            activeCalcField = "";
        }
        else
        {
            CloseAllPopups();
            activeCalcField = fieldKey;
            calcNewNumber = true;
            calcOperator = "";
            calcOperand = double.TryParse(GetCurrentCalcValue(), out var d) ? d : 0;
        }
    }

    private string GetCurrentCalcValue() => activeCalcField switch
    {
        "minLimit" => alertMinLimit,
        "maxLimit" => alertMaxLimit,
        "stagnant" => alertStagnantPeriod,
        "expiry" => alertExpiryAlert,
        "installation" => alertInstallationFee,
        _ => "0"
    };

    private void SetCurrentCalcValue(string val)
    {
        switch (activeCalcField)
        {
            case "minLimit": alertMinLimit = val; break;
            case "maxLimit": alertMaxLimit = val; break;
            case "stagnant": alertStagnantPeriod = val; break;
            case "expiry": alertExpiryAlert = val; break;
            case "installation": alertInstallationFee = val; break;
        }
    }

    private void CalcDigit(string digit)
    {
        string current = GetCurrentCalcValue();
        if (calcNewNumber || current == "0")
        {
            SetCurrentCalcValue(digit);
            calcNewNumber = false;
        }
        else
        {
            SetCurrentCalcValue(current + digit);
        }
    }

    private void CalcDecimal()
    {
        string current = GetCurrentCalcValue();
        if (calcNewNumber)
        {
            SetCurrentCalcValue("0.");
            calcNewNumber = false;
        }
        else if (!current.Contains("."))
        {
            SetCurrentCalcValue(current + ".");
        }
    }

    private void CalcClear()
    {
        SetCurrentCalcValue("0");
        calcOperand = 0;
        calcOperator = "";
        calcNewNumber = true;
    }

    private void CalcClearEntry()
    {
        SetCurrentCalcValue("0");
        calcNewNumber = true;
    }

    private void CalcBackspace()
    {
        string current = GetCurrentCalcValue();
        if (current.Length > 1)
            SetCurrentCalcValue(current[..^1]);
        else
            SetCurrentCalcValue("0");
    }

    private void CalcNegate()
    {
        if (double.TryParse(GetCurrentCalcValue(), out var val))
        {
            val = -val;
            SetCurrentCalcValue(val.ToString());
        }
    }

    private void CalcSqrt()
    {
        if (double.TryParse(GetCurrentCalcValue(), out var val) && val >= 0)
        {
            SetCurrentCalcValue(Math.Sqrt(val).ToString());
            calcNewNumber = true;
        }
    }

    private void CalcReciprocal()
    {
        if (double.TryParse(GetCurrentCalcValue(), out var val) && val != 0)
        {
            SetCurrentCalcValue((1.0 / val).ToString());
            calcNewNumber = true;
        }
    }

    private void CalcPercent()
    {
        if (double.TryParse(GetCurrentCalcValue(), out var val))
        {
            SetCurrentCalcValue((val / 100.0).ToString());
            calcNewNumber = true;
        }
    }

    private void CalcOp(string op)
    {
        if (double.TryParse(GetCurrentCalcValue(), out var current))
        {
            if (!string.IsNullOrEmpty(calcOperator) && !calcNewNumber)
            {
                calcOperand = ExecuteOp(calcOperand, current, calcOperator);
                SetCurrentCalcValue(calcOperand.ToString());
            }
            else
            {
                calcOperand = current;
            }
        }
        calcOperator = op;
        calcNewNumber = true;
    }

    private void CalcEquals()
    {
        if (!string.IsNullOrEmpty(calcOperator) && double.TryParse(GetCurrentCalcValue(), out var current))
        {
            calcOperand = ExecuteOp(calcOperand, current, calcOperator);
            SetCurrentCalcValue(calcOperand.ToString());
            calcOperator = "";
            calcNewNumber = true;
        }
    }

    private double ExecuteOp(double a, double b, string op) => op switch
    {
        "+" => a + b,
        "-" => a - b,
        "*" => a * b,
        "/" => b != 0 ? a / b : 0,
        _ => b
    };


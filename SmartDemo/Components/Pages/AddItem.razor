@if (isAccountsModalOpen)
{
    <div class="modal-backdrop-blur accounts-tree-modal-layer">
        <div class="accounts-tree-dialog" dir="rtl" @onclick:stopPropagation>
            <div class="accounts-tree-topbar">
                <span class="accounts-tree-title">الحسابات</span>
                <div class="accounts-topbar-actions">
                    <button type="button" class="btn-acc-win" title="تصغير">_</button>
                    <button type="button" class="btn-acc-win" title="تكبير">□</button>
                    <button type="button" class="btn-acc-win btn-acc-close" @onclick="() => isAccountsModalOpen = false">✕</button>
                </div>
            </div>

            <div class="accounts-search-bar">
                <span class="acc-search-lbl">بحث</span>
                <input type="text" class="clean-input flex-1 acc-search-input" placeholder="...Enter text to search" @bind="accountSearchTerm" @bind:event="oninput" />
            </div>

            <div class="accounts-tree-table-header">
                <div class="acc-col-name">الاسم</div>
                <div class="acc-col-code">رقم الحساب</div>
            </div>

            <div class="accounts-tree-body">
                @foreach (var acc in FilteredAccountNodes)
                {
                    <div class="acc-row @(selectedAccountId == acc.Code ? "acc-selected-row" : "") @(acc.Level > 0 ? "acc-child-color" : "acc-parent-color")"
                         style="padding-right: @(acc.Level * 18 + 8)px;"
                         @onclick="() => SelectAccountNode(acc)"
                         @ondblclick="() => ApplySelectedAccount(acc)">
                        <div class="acc-col-name">
                            @if (acc.Children.Any())
                            {
                                <span class="acc-arrow-toggle" @onclick:stopPropagation @onclick="() => acc.IsExpanded = !acc.IsExpanded">
                                    <i class="bi @(acc.IsExpanded ? "bi-caret-down-fill" : "bi-caret-left-fill")"></i>
                                </span>
                            }
                            <span>@acc.Name</span>
                        </div>
                        <div class="acc-col-code">@acc.Code</div>
                    </div>

                    @if (acc.IsExpanded && acc.Children.Any())
                    {
                        @foreach (var child in acc.Children)
                        {
                            <div class="acc-row @(selectedAccountId == child.Code ? "acc-selected-row" : "") acc-child-color"
                                 style="padding-right: @(child.Level * 18 + 8)px;"
                                 @onclick="() => SelectAccountNode(child)"
                                 @ondblclick="() => ApplySelectedAccount(child)">
                                <div class="acc-col-name">
                                    @if (child.Children.Any())
                                    {
                                        <span class="acc-arrow-toggle" @onclick:stopPropagation @onclick="() => child.IsExpanded = !child.IsExpanded">
                                            <i class="bi @(child.IsExpanded ? "bi-caret-down-fill" : "bi-caret-left-fill")"></i>
                                        </span>
                                    }
                                    <span>@child.Name</span>
                                </div>
                                <div class="acc-col-code">@child.Code</div>
                            </div>

                            @if (child.IsExpanded && child.Children.Any())
                            {
                                @foreach (var grandChild in child.Children)
                                {
                                    <div class="acc-row @(selectedAccountId == grandChild.Code ? "acc-selected-row" : "") acc-child-color"
                                         style="padding-right: @(grandChild.Level * 18 + 8)px;"
                                         @onclick="() => SelectAccountNode(grandChild)"
                                         @ondblclick="() => ApplySelectedAccount(grandChild)">
                                        <div class="acc-col-name">
                                            <span>@grandChild.Name</span>
                                        </div>
                                        <div class="acc-col-code">@grandChild.Code</div>
                                    </div>
                                }
                            }
                        }
                    }
                }
            </div>

            <div class="accounts-tree-footer">
                <span class="acc-hint-green">أضغط مرتين على الحساب المطلوب حتى يتم اختياره</span>
            </div>
        </div>
    </div>
}


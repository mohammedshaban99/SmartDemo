public class TaxAccountItem
{
    public string Name { get; set; } = "";
    public string SalesRate { get; set; } = "";
    public string PurchaseRate { get; set; } = "";
    }

    private List<TaxAccountItem> taxAccountsList = new()
    {
        new() { Name = "ضريبة القيمة المضافة 14 %", SalesRate = "14", PurchaseRate = "14" },
        new() { Name = "ضريبة القيمة المضافة 15 %", SalesRate = "15", PurchaseRate = "15" },
        new() { Name = "ضريبة القيمة المضافة 5 %", SalesRate = "5", PurchaseRate = "5" },
        new() { Name = "ضريبة رسم التنمية", SalesRate = "2", PurchaseRate = "2" },
        new() { Name = "ضريبة الجدول", SalesRate = "0.5", PurchaseRate = "0.5" }
    };

    private void SelectTaxAccount(string name)
{
    itemData.TaxAccount = name;
    var found = taxAccountsList.FirstOrDefault(t => t.Name == name);
    if (found != null)
    {
        if (decimal.TryParse(found.SalesRate, out var sr)) itemData.TaxSalesRate = sr;
        if (decimal.TryParse(found.PurchaseRate, out var pr)) itemData.TaxPurchaseRate = pr;
    }
    isTaxAccountPopupOpen = false;
}

private RenderFragment RenderAccountsTreeDropdownNodeForSales(AccountsTreeNode node, Action<string> onSelected) => @<text>
    <div class="tree-grid-row @(itemData.SalesAccount == node.Name ? "active-row" : "") @(node.Level > 0 ? "tree-child-row" : "")"
         style="padding-right: @(node.Level * 16 + 12)px;"
         @onclick="() => onSelected(node.Name)">
        <span class="tree-node-code col-code text-center text-muted" style="border-left: 1px solid #dee2e6;">
            @node.Code
        </span>
        <span class="tree-node-name col-name text-right" style="padding-right: 8px;">
            @if (node.Children.Any())
            {
                <span class="ms-1 toggle-arrow-wrap" @onclick:stopPropagation @onclick="() => node.IsExpanded = !node.IsExpanded">
                    <i class="bi @(node.IsExpanded ? "bi-chevron-down" : "bi-chevron-left") small text-muted"></i>
                </span>
            }
            @node.Name
        </span>
    </div>
@if (node.IsExpanded && node.Children.Any())
{
    @foreach (var child in node.Children)
    {
        @RenderAccountsTreeDropdownNodeForSales(child, onSelected)
    }
}
</text>;


@page "/AddItem"
@rendermode InteractiveServer

<div class="page-viewport" dir="rtl" @onclick="CloseAllPopups">
    <div class="main-canvas" @onclick:stopPropagation>

        <!-- Top Header Area -->
        <div class="header-master-grid">

            <!-- 1. Far Right: Image Box & Active Status with Orange Bar -->
            <div class="image-right-block">
                <div class="image-square">
                    <span class="image-placeholder-text">الصورة</span>
                </div>
                <div class="active-check-group">
                    <input type="checkbox" id="chkActive" class="chk-box" @bind="itemData.IsActive" />
                    <label for="chkActive" class="small-chk-label">نشط</label>
                </div>
                <div class="orange-divider-line"></div>
            </div>

            <!-- 2. Section Labels -->
            <div class="labels-column">
                <div class="label-row-cell"><span class="hdr-lbl">الرقم</span></div>
                <div class="label-row-cell"><span class="hdr-lbl">الاسم</span></div>
                <div class="label-row-cell"><span class="hdr-lbl">نوع الصنف</span></div>
            </div>

            <!-- 3. Form Input Controls -->
            <div class="controls-column">
                <!-- Row 1: Number & QR Barcode Trigger Combo -->
                <div class="form-row-compact pos-relative">
                    <input type="text" class="clean-input barcode-main-input text-center" @bind="itemData.BarcodeNumber" />

                    <div class="modal-code-combo-wrapper">
                        <div class="group-prefix-combo" @onclick="ToggleBarcodeTypePopup" @onclick:stopPropagation>
                            <span class="combo-arrow">▼</span>
                            <span class="ico-swap">@GetSelectedBarcodeIcon()</span>
                        </div>

                        @if (isBarcodeTypePopupOpen)
                        {
                            <div class="modal-code-dropdown-panel header-barcode-popup" @onclick:stopPropagation>
                                <div class="modal-dropdown-row @(selectedBarcodeOption == "تلقائي" ? "active-code-row" : "")"
                                     @onclick='() => SelectBarcodeOption("تلقائي")'>
                                    <span>⚙️</span>
                                    <span>تلقائي</span>
                                </div>
                                <div class="modal-dropdown-row @(selectedBarcodeOption == "بالمجموعة" ? "active-code-row" : "")"
                                     @onclick='() => SelectBarcodeOption("بالمجموعة")'>
                                    <span>📁</span>
                                    <span>بالمجموعة</span>
                                </div>
                                <div class="modal-dropdown-row @(selectedBarcodeOption == "يدوي" ? "active-code-row" : "")"
                                     @onclick='() => SelectBarcodeOption("يدوي")'>
                                    <span>✋</span>
                                    <span>يدوي</span>
                                </div>
                            </div>
                        }
                    </div>

                    <span class="req-star me-1 ms-1">*</span>

                    @if (selectedBarcodeOption != "بالمجموعة")
                    {
                        <span class="text-success fw-bold ms-1">✔</span>
                    }

                    <button type="button" class="btn-qr-hover" @onclick="OpenQrModal">QR</button>
                </div>

                <!-- Row 2: Name Input with Translation Icon on Left -->
                <div class="form-row-compact name-field-relative">
                    <div class="w-100">
                        <input type="text" class="clean-input w-100" @bind="itemData.Name" />
                    </div>

                    <span class="req-star me-1 ms-1">*</span>

                    <button type="button" class="btn-trans-trigger" @onclick="ToggleTranslationPopup" title="ترجمة الأسماء">
                        <span class="ico-trans-char">🌐</span>
                    </button>

                    @if (isTranslationPopupOpen)
                    {
                        <div class="trans-popup-box">
                            <div class="trans-input-wrap">
                                <input type="text" class="trans-input text-end" @bind="itemData.EnglishName" placeholder="الاسم انجليزي" />
                            </div>
                            <div class="trans-popup-actions">
                                <button type="button" class="btn-popup-icon" @onclick="OpenLanguagesModal" title="إعدادات اللغات">⚙</button>
                                <button type="button" class="btn-popup-icon" @onclick="CloseTranslationPopup" title="إغلاق">✕</button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Row 3: Item Type -->
                <div class="form-row-compact pos-relative">
                    <div class="dropdown-anchor" style="width: 250px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleItemTypePopup">
                            <span class="combo-display-text">@itemData.ItemType</span>
                            <div class="combo-icons-inside">
                                <span class="combo-arrow">▼</span>
                            </div>
                        </div>

                        @if (isItemTypePopupOpen)
                        {
                            <div class="custom-table-popup item-type-popup-size" @onclick:stopPropagation>
                                <div class="table-popup-header">الاسم</div>
                                <div class="table-popup-list">
                                    @foreach (var typeName in itemTypeList)
                                    {
                                        <div class="table-popup-row @(itemData.ItemType == typeName ? "active-row" : "")"
                                             @onclick="() => SelectItemType(typeName)">
                                            @typeName
                                        </div>
                                    }
                                </div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isItemTypePopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>

                    <span class="req-star me-2 ms-1">*</span>
                    <span class="type-description-hint">@itemData.ItemTypeNote</span>
                </div>
            </div>

            <!-- 4. Save Button on Far Left -->
            <div class="save-cell">
                <button class="btn-primary-custom" @onclick="SaveData" type="button">حفظ</button>
            </div>

        </div>

        <!-- Navigation Tabs Bar -->
        <div class="tab-strip-bar">
            <button class="strip-tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1" type="button">بيانات الصنف</button>
            <button class="strip-tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2" type="button">الحسابات</button>
            <button class="strip-tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => activeTab = 3" type="button">الخصائص</button>
            <button class="strip-tab-btn @(activeTab == 4 ? "active" : "")" @onclick="() => activeTab = 4" type="button">الحقول الإضافية</button>
            <button class="strip-tab-btn @(activeTab == 5 ? "active" : "")" @onclick="() => activeTab = 5" type="button">المعادلة</button>
        </div>

        <!-- Tab 1: بيانات الصنف -->
        @if (activeTab == 1)
        {
            <div class="tab-content-seamless">
                <div class="section-title-header mb-3">
                    <span class="fw-bold fs-6 text-dark">التصنيف</span>
                </div>

                <div class="section-with-blue-line mb-4">
                    <div class="two-column-form-grid">
                        <div class="form-side-column">
                            <!-- 1. الفرع -->
                            <div class="field-entry-line">
                                <span class="field-title">الفرع</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" title="@GetSelectedBranchesTooltip()" @onclick:stopPropagation @onclick="ToggleBranchPopup">
                                        <span class="combo-display-text">@GetSelectedBranchesSummary()</span>
                                        <div class="combo-icons-inside">
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isBranchPopupOpen)
                                    {
                                        <div class="custom-dropdown-panel" @onclick:stopPropagation>
                                            <div class="panel-scroll-content">
                                                <div class="panel-checkbox-row select-all-row" @onclick="ToggleAllBranches">
                                                    <input type="checkbox" class="chk-box" checked="@IsAllBranchesSelected" />
                                                    <span class="checkbox-label">(Select All)</span>
                                                </div>
                                                @foreach (var b in branchList)
                                                {
                                                    <div class="panel-checkbox-row" @onclick="() => b.IsSelected = !b.IsSelected">
                                                        <input type="checkbox" class="chk-box" @bind="b.IsSelected" @onclick:stopPropagation />
                                                        <span class="checkbox-label">@b.Name</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="panel-footer-actions">
                                                <button type="button" class="btn-panel-cancel" @onclick="() => isBranchPopupOpen = false">إلغاء</button>
                                                <button type="button" class="btn-panel-ok" @onclick="() => isBranchPopupOpen = false">موافق</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>

                            <!-- 2. المخازن -->
                            <div class="field-entry-line">
                                <span class="field-title">المخازن</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" title="@GetSelectedWarehousesTooltip()" @onclick:stopPropagation @onclick="ToggleWarehousePopup">
                                        <span class="combo-display-text">@GetSelectedWarehousesSummary()</span>
                                        <div class="combo-icons-inside">
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isWarehousePopupOpen)
                                    {
                                        <div class="custom-dropdown-panel" @onclick:stopPropagation>
                                            <div class="panel-scroll-content">
                                                <div class="panel-checkbox-row select-all-row" @onclick="ToggleAllWarehouses">
                                                    <input type="checkbox" class="chk-box" checked="@IsAllWarehousesSelected" />
                                                    <span class="checkbox-label">(كل المخازن)</span>
                                                </div>
                                                @foreach (var w in warehouseList)
                                                {
                                                    <div class="panel-checkbox-row" @onclick="() => w.IsSelected = !w.IsSelected">
                                                        <input type="checkbox" class="chk-box" @bind="w.IsSelected" @onclick:stopPropagation />
                                                        <span class="checkbox-label">@w.Name</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="panel-footer-actions">
                                                <button type="button" class="btn-panel-cancel" @onclick="() => isWarehousePopupOpen = false">إلغاء</button>
                                                <button type="button" class="btn-panel-ok" @onclick="() => isWarehousePopupOpen = false">موافق</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>

                            <!-- 3. المجموعة -->
                            <div class="field-entry-line">
                                <span class="field-title">المجموعة</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleGroupPopup">
                                        <span class="combo-display-text">@itemData.GroupCategory</span>
                                        <div class="combo-icons-inside">
                                            <button class="btn-inside-plus" type="button" @onclick:stopPropagation @onclick="OpenGroupModal" title="إضافة مجموعة">+</button>
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isGroupPopupOpen)
                                    {
                                        <div class="custom-table-popup" @onclick:stopPropagation>
                                            <div class="table-popup-header">الاسم</div>
                                            <div class="table-popup-list">
                                                @foreach (var g in groupList)
                                                {
                                                    <div class="table-popup-row @(itemData.GroupCategory == g ? "active-row" : "")"
                                                         @onclick="() => SelectGroup(g)">
                                                        @g
                                                    </div>
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isGroupPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- 4. الباركود العالمي -->
                            <div class="field-entry-line">
                                <span class="field-title">الباركود العالمي</span>
                                <div class="barcode-control flex-1 field-fixed-width">
                                    <select class="mini-prefix-select" @bind="itemData.GlobalBarcodeType">
                                        <option value="GS1">GS1</option>
                                        <option value="EAN">EAN</option>
                                    </select>
                                    <input type="text" class="clean-input flex-1 border-0" @bind="itemData.GlobalBarcodeValue" />
                                </div>
                            </div>

                            <!-- 5. وحدات القياس -->
                            <div class="field-entry-line">
                                <span class="field-title">وحدات القياس</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleUnitPopup">
                                        <span class="combo-display-text">@itemData.MeasurementUnit</span>
                                        <div class="combo-icons-inside">
                                            <button class="btn-inside-plus" type="button" @onclick:stopPropagation @onclick="OpenUnitsModal" title="إضافة وحدة">+</button>
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isUnitPopupOpen)
                                    {
                                        <div class="custom-table-popup" @onclick:stopPropagation>
                                            <div class="table-popup-header">الاسم</div>
                                            <div class="table-popup-search-box">
                                                <input type="text" class="clean-input w-100" @bind="unitSearchTerm" @bind:event="oninput" placeholder="" />
                                            </div>
                                            <div class="table-popup-list">
                                                @foreach (var u in FilteredUnitList)
                                                {
                                                    <div class="table-popup-row @(itemData.MeasurementUnit == u ? "active-row" : "")"
                                                         @onclick="() => SelectUnit(u)">
                                                        @u
                                                    </div>
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isUnitPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="form-side-column">
                            <!-- 6. اسم المورد -->
                            <div class="field-entry-line">
                                <span class="field-title">اسم المورد</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleSupplierPopup">
                                        <span class="combo-display-text">@itemData.SupplierName</span>
                                        <div class="combo-icons-inside">
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isSupplierPopupOpen)
                                    {
                                        <div class="custom-supplier-grid-panel-advanced" @onclick:stopPropagation>
                                            <div class="supplier-grid-header">
                                                <div class="col-code">الكود</div>
                                                <div class="col-name">الاسم</div>
                                                <div class="col-acc">الحساب</div>
                                                <div class="col-action">=</div>
                                            </div>
                                            <div class="supplier-grid-subbar">
                                                <div class="col-code text-center text-muted small">🔤</div>
                                                <div class="col-name text-center text-muted small">🔤</div>
                                                <div class="col-acc text-center text-muted small">=</div>
                                                <div class="col-action text-center">=</div>
                                            </div>
                                            <div class="supplier-grid-rows">
                                                @foreach (var sup in supplierList)
                                                {
                                                    <div class="supplier-row @(itemData.SupplierName == sup.Name ? "active-row" : "")"
                                                         @onclick="() => SelectSupplier(sup.Name)">
                                                        <div class="col-code">@sup.Code</div>
                                                        <div class="col-name">@sup.Name</div>
                                                        <div class="col-acc">@sup.Account</div>
                                                        <div class="col-action"></div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>

                            <!-- 7. سياسة التوزيع -->
                            <div class="field-entry-line">
                                <span class="field-title">سياسة التوزيع</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="TogglePolicyPopup">
                                        <span class="combo-display-text">@itemData.DistributionPolicy</span>
                                        <div class="combo-icons-inside">
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>

                                    @if (isPolicyPopupOpen)
                                    {
                                        <div class="custom-table-popup" @onclick:stopPropagation>
                                            <div class="table-popup-header">الاسم</div>
                                            <div class="table-popup-list">
                                                @foreach (var p in policyList)
                                                {
                                                    <div class="table-popup-row @(itemData.DistributionPolicy == p ? "active-row" : "")"
                                                         @onclick="() => SelectPolicy(p)">
                                                        @p
                                                    </div>
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isPolicyPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>

                            <!-- 8. حساب الاستاذ -->
                            <div class="field-entry-line">
                                <span class="field-title">حساب الاستاذ</span>
                                <div class="dropdown-anchor flex-1 field-fixed-width">
                                    <div class="custom-combo-trigger">
                                        <select class="clean-select-overlay" @bind="itemData.GeneralLedgerAccount">
                                            <option value=""></option>
                                            @foreach (var a in ledgerAccounts)
                                            {
                                                <option value="@a">@a</option>
                                            }
                                        </select>
                                        <span class="combo-display-text">@itemData.GeneralLedgerAccount</span>
                                        <div class="combo-icons-inside">
                                            <button class="btn-inside-plus" type="button" title="إضافة حساب">+</button>
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="field-entry-line spacer-line"></div>

                            <!-- 9. طريقة تقييم المخزون -->
                            <div class="field-entry-line">
                                <span class="field-title">طريقة تقييم المخزون</span>
                                <select class="clean-input flex-1 field-fixed-width" @bind="itemData.ValuationMethod">
                                    @foreach (var vm in valuationMethods)
                                    {
                                        <option value="@vm">@vm</option>
                                    }
                                </select>
                                <span class="req-star me-1">*</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table Section -->
                <div class="section-with-blue-line mb-4">
                    <div class="table-scroll-wrapper">
                        <table class="item-details-table">
                            <thead>
                                <tr>
                                    <th>الباركود</th>
                                    <th>عدد القطع</th>
                                    <th>الوحدة</th>
                                    <th>سعر الشراء</th>
                                    <th>سعر البيع</th>
                                    <th>أفتراضي للشراء</th>
                                    <th>أفتراضي للبيع</th>
                                    <th>نشط</th>
                                    <th style="width: 32px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in itemData.UnitsTableRows)
                                {
                                    <tr>
                                        <td>@row.Barcode</td>
                                        <td>@row.PiecesCount</td>
                                        <td>@row.Unit</td>
                                        <td>@row.PurchasePrice</td>
                                        <td>@row.SalePrice</td>
                                        <td><input type="checkbox" @bind="row.IsDefaultPurchase" /></td>
                                        <td><input type="checkbox" @bind="row.IsDefaultSale" /></td>
                                        <td><input type="checkbox" @bind="row.IsActive" /></td>
                                        <td><button class="delete-icon-btn" type="button">✖</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Opening Balance Section -->
                <div class="section-with-blue-line">
                    <div class="opening-balance-section">
                        <span class="opening-balance-lbl">الرصيد الإفتتاحي</span>
                        <select class="clean-input" style="width: 170px;" @bind="itemData.OpeningBalance">
                            <option value=""></option>
                            <option value="رصيد أولي 1">رصيد أولي 1</option>
                        </select>
                    </div>
                </div>
            </div>
        }

        <!-- Tab 2: الحسابات -->
        @if (activeTab == 2)
        {
            <div class="tab-content-seamless">
                <div class="accounts-tab-grid">
                    <div class="accounts-column-block">
                        <div class="section-block-title text-primary">الضرائب</div>
                        <div class="section-with-blue-line mb-4">
                            <div class="field-entry-line">
                                <span class="field-title-wide">يخضع القيمة المضافة ؟</span>
                                <select class="clean-input flex-1" @bind="itemData.VatApplicable">
                                    <option value="نعم">كما بالفاتورة</option>
                                    <option value="لا">لا</option>
                                </select>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">حساب الضريبة</span>
                                <select class="clean-input flex-1" @bind="itemData.TaxAccount">
                                    <option></option>
                                    @foreach (var t in taxAccounts)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                                <span class="req-star me-1">*</span>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">نسبة الضريبة</span>
                                <div class="d-flex align-items-center gap-2 flex-1">
                                    <input type="number" class="clean-input text-center" style="width: 70px;" value="0" />
                                    <span class="small text-muted">المبيعات</span>
                                    <input type="number" class="clean-input text-center" style="width: 70px;" value="0" />
                                    <span class="small text-muted">المشتريات</span>
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">سعر الصنف يشمل الضريبة ؟</span>
                                <div class="d-flex align-items-center gap-2 flex-1">
                                    <input type="checkbox" class="form-check-input m-0" />
                                    <span class="small text-muted">لا</span>
                                </div>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">يخضع لضريبة الخصم</span>
                                <select class="clean-input flex-1"><option>كما بالفاتورة</option></select>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">حساب ضريبة الخصم</span>
                                <select class="clean-input flex-1"><option></option></select>
                            </div>
                            <div class="field-entry-line">
                                <span class="field-title-wide">نسبة الضريبة</span>
                                <input type="number" class="clean-input" style="width: 90px;" value="0" />
                            </div>
                        </div>

                        <div class="section-block-title text-primary">التنبيهات</div>
                        <div class="section-with-blue-line">
                            <div class="field-entry-line">
                                <span class="field-title-wide">الحد الادنى</span>
                                <input type="number" class="clean-input" style="width: 90px;" @bind="itemData.MinLimit" />

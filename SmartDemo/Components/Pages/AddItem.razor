// Calculator Popup State & Logic for Additional Fields (Tab 4) and Accounts (Tab 2)
private bool isLengthCalcOpen = false;
private bool isWidthCalcOpen = false;
private bool isHeightCalcOpen = false;
private bool isPanelsCalcOpen = false;
private bool isMinLimitCalcOpen = false;
private bool isMaxLimitCalcOpen = false;
private bool isStagnationCalcOpen = false;
private bool isAdditionalCostCalcOpen = false;

private string calcDisplay = "0";
private string activeCalcTarget = "";

private void ToggleLengthCalc() { bool wasOpen = isLengthCalcOpen; CloseAllPopups(); isLengthCalcOpen = !wasOpen; if (isLengthCalcOpen) { activeCalcTarget = "Length"; calcDisplay = string.IsNullOrEmpty(itemData.AdditionalLength) || itemData.AdditionalLength == "0" ? "0" : itemData.AdditionalLength; } }
private void ToggleWidthCalc() { bool wasOpen = isWidthCalcOpen; CloseAllPopups(); isWidthCalcOpen = !wasOpen; if (isWidthCalcOpen) { activeCalcTarget = "Width"; calcDisplay = string.IsNullOrEmpty(itemData.AdditionalWidth) || itemData.AdditionalWidth == "0" ? "0" : itemData.AdditionalWidth; } }
private void ToggleHeightCalc() { bool wasOpen = isHeightCalcOpen; CloseAllPopups(); isHeightCalcOpen = !wasOpen; if (isHeightCalcOpen) { activeCalcTarget = "Height"; calcDisplay = string.IsNullOrEmpty(itemData.AdditionalHeight) || itemData.AdditionalHeight == "0" ? "0" : itemData.AdditionalHeight; } }
private void TogglePanelsCalc() { bool wasOpen = isPanelsCalcOpen; CloseAllPopups(); isPanelsCalcOpen = !wasOpen; if (isPanelsCalcOpen) { activeCalcTarget = "Panels"; calcDisplay = string.IsNullOrEmpty(itemData.AdditionalPanels) || itemData.AdditionalPanels == "0" ? "0" : itemData.AdditionalPanels; } }
private void ToggleMinLimitCalc() { bool wasOpen = isMinLimitCalcOpen; CloseAllPopups(); isMinLimitCalcOpen = !wasOpen; if (isMinLimitCalcOpen) { activeCalcTarget = "MinLimit"; calcDisplay = itemData.MinLimit.ToString(); } }
private void ToggleMaxLimitCalc() { bool wasOpen = isMaxLimitCalcOpen; CloseAllPopups(); isMaxLimitCalcOpen = !wasOpen; if (isMaxLimitCalcOpen) { activeCalcTarget = "MaxLimit"; calcDisplay = itemData.MaxLimit.ToString(); } }
private void ToggleStagnationCalc() { bool wasOpen = isStagnationCalcOpen; CloseAllPopups(); isStagnationCalcOpen = !wasOpen; if (isStagnationCalcOpen) { activeCalcTarget = "StagnationPeriod"; calcDisplay = itemData.StagnationPeriod.ToString(); } }
private void ToggleAdditionalCostCalc() { bool wasOpen = isAdditionalCostCalcOpen; CloseAllPopups(); isAdditionalCostCalcOpen = !wasOpen; if (isAdditionalCostCalcOpen) { activeCalcTarget = "AdditionalCost"; calcDisplay = itemData.AdditionalCost.ToString(); } }

private void CalcPress(string val)
{
    if (calcDisplay == "0" && val != ".") calcDisplay = val;
    else calcDisplay += val;
    ApplyCalcResult();
}
private void CalcClear() { calcDisplay = "0"; ApplyCalcResult(); }
private void CalcClearEntry() { calcDisplay = "0"; ApplyCalcResult(); }
private void CalcBack() { if (calcDisplay.Length > 1) calcDisplay = calcDisplay.Substring(0, calcDisplay.Length - 1); else calcDisplay = "0"; ApplyCalcResult(); }
private void CalcToggleSign() { if (calcDisplay.StartsWith("-")) calcDisplay = calcDisplay.Substring(1); else if (calcDisplay != "0") calcDisplay = "-" + calcDisplay; ApplyCalcResult(); }
private void CalcEquals()
{
    try
    {
        var dt = new System.Data.DataTable();
        var res = dt.Compute(calcDisplay.Replace("x", "*"), "");
        calcDisplay = res?.ToString() ?? "0";
    }
    catch { }
    ApplyCalcResult();
}
private void ApplyCalcResult()
{
    if (activeCalcTarget == "Length") itemData.AdditionalLength = calcDisplay;
    else if (activeCalcTarget == "Width") itemData.AdditionalWidth = calcDisplay;
    else if (activeCalcTarget == "Height") itemData.AdditionalHeight = calcDisplay;
    else if (activeCalcTarget == "Panels") itemData.AdditionalPanels = calcDisplay;
    else if (activeCalcTarget == "MinLimit") { if (int.TryParse(calcDisplay, out var val)) itemData.MinLimit = val; }
    else if (activeCalcTarget == "MaxLimit") { if (int.TryParse(calcDisplay, out var val)) itemData.MaxLimit = val; }
    else if (activeCalcTarget == "StagnationPeriod") { if (int.TryParse(calcDisplay, out var val)) itemData.StagnationPeriod = val; }
    else if (activeCalcTarget == "AdditionalCost") { if (decimal.TryParse(calcDisplay, out var val)) itemData.AdditionalCost = val; }
}


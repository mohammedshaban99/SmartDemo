    private RenderFragment RenderNestedTreeNode(NestedTreeNodeModel node, Action<string> onSelected) => @<text>
    <div class="supplier-row @(supplierData.NestedWithin == node.Name ? "active-row" : "") @(node.Level > 0 ? "tree-child-row" : "")"
         style="padding-right: @(node.Level * 18 + 12)px;"
         @onclick="() => onSelected(node.Name)">
        <div class="col-name d-flex align-items-center">
            @if (node.Children.Any())
                        {
            <span class="toggle-arrow-btn me-2" @onclick:stopPropagation @onclick="() => node.IsExpanded = !node.IsExpanded">
                @(node.IsExpanded ? "▼" : "◀")
            </span>
                        }
                        else
                        {
            <span class="leaf-dot me-2">•</span>
                        }
            <span>@node.Name</span>
        </div>
    </div>
@if (node.IsExpanded && node.Children.Any())
    {
@foreach (var child in node.Children)
    {
@RenderNestedTreeNode(child, onSelected)
    }
    }
</text>;


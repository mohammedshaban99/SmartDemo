@code {
    private int activeTab = 1;
    private bool isBranchPopupOpen = false;
    private bool isNestedPopupOpen = false;
    private bool isCurrencyPopupOpen = false;
    private bool isLedgerPopupOpen = false;
    private bool isDealTypePopupOpen = false;
    private bool isDealSidePopupOpen = false;
    private bool isCompPopupOpen = false;
    private bool isPriceTierPopupOpen = false;
    private bool isDiscountTiersPopupOpen = false;
    private bool isCreditCalcOpen = false;
    private bool isTaxDropdownPopupOpen = false;
    private bool isCountryPopupOpen = false;
    private bool isRegionPopupOpen = false;

    private string calcDisplay = "0";

    /* Confirmation Modal States */
    private bool isConfirmDeleteModalOpen = false;
    private DiscountTierItem? tierPendingDelete = null;

    /* Calculator for Discount Tier row */
    private DiscountTierItem? activeCalcTier = null;
    private string tierCalcDisplay = "0";

    /* ================= Nested (يوجد بداخل) Modal State & Models ================= */
    private bool isNestedModalOpen = false;
    private bool isModalBranchPopupOpen = false;
    private bool isModalParentGroupPopupOpen = false;
    private bool isModalShowWithPopupOpen = false;

    private readonly List<string> showWithOptions = new() { "الكل", "العملاء", "الموردين" };

    public class NestedGroupModel
    {
        public string Code { get; set; } = "1";
        public string Name { get; set; } = "";
        public string Branch { get; set; } = "الفرع الرئيسي";
        public bool AllBranches { get; set; } = false;
        public string ParentGroup { get; set; } = "";
        public string ShowWith { get; set; } = "الكل";
        public string Notes { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }

    private NestedGroupModel newNestedModel = new();

    private void OpenNestedModal()
    {
        CloseAllPopups();
        newNestedModel = new NestedGroupModel
        {
            Code = (mockNestedTree.Count + 1).ToString(),
            Branch = supplierData.Branch ?? "الفرع الرئيسي",
            ParentGroup = supplierData.NestedWithin ?? "",
            ShowWith = "الكل",
            IsActive = true
        };
        isNestedModalOpen = true;
    }

    private void CloseNestedModal()
    {
        isNestedModalOpen = false;
        isModalBranchPopupOpen = false;
        isModalParentGroupPopupOpen = false;
        isModalShowWithPopupOpen = false;
    }

    private void ToggleModalBranchPopup()
    {
        bool wasOpen = isModalBranchPopupOpen;
        isModalBranchPopupOpen = !wasOpen;
        isModalParentGroupPopupOpen = false;
        isModalShowWithPopupOpen = false;
    }

    private void ToggleModalParentGroupPopup()
    {
        bool wasOpen = isModalParentGroupPopupOpen;
        isModalParentGroupPopupOpen = !wasOpen;
        isModalBranchPopupOpen = false;
        isModalShowWithPopupOpen = false;
    }

    private void ToggleModalShowWithPopup()
    {
        bool wasOpen = isModalShowWithPopupOpen;
        isModalShowWithPopupOpen = !wasOpen;
        isModalBranchPopupOpen = false;
        isModalParentGroupPopupOpen = false;
    }

    private void SaveNestedModal()
    {
        if (!string.IsNullOrWhiteSpace(newNestedModel.Name))
        {
            if (string.IsNullOrWhiteSpace(newNestedModel.ParentGroup))
            {
                mockNestedTree.Add(new NestedTreeNodeModel
                {
                    Name = newNestedModel.Name,
                    Level = 0,
                    IsExpanded = true
                });
            }
            else
            {
                var parent = FindTreeNode(mockNestedTree, newNestedModel.ParentGroup);
                if (parent != null)
                {
                    parent.Children.Add(new NestedTreeNodeModel
                    {
                        Name = newNestedModel.Name,
                        Level = parent.Level + 1,
                        IsExpanded = true
                    });
                    parent.IsExpanded = true;
                }
                else
                {
                    mockNestedTree.Add(new NestedTreeNodeModel
                    {
                        Name = newNestedModel.Name,
                        Level = 0,
                        IsExpanded = true
                    });
                }
            }

            supplierData.NestedWithin = newNestedModel.Name;
        }

        CloseNestedModal();
    }

    private NestedTreeNodeModel? FindTreeNode(List<NestedTreeNodeModel> nodes, string name)
    {
        foreach (var node in nodes)
        {
            if (node.Name == name) return node;
            var found = FindTreeNode(node.Children, name);
            if (found != null) return found;
        }
        return null;
    }

    private bool IsAnyPopupOpen() =>
        isBranchPopupOpen ||
        isNestedPopupOpen ||
        isCurrencyPopupOpen ||
        isLedgerPopupOpen ||
        isDealTypePopupOpen ||
        isDealSidePopupOpen ||
        isCompPopupOpen ||
        isPriceTierPopupOpen ||
        isDiscountTiersPopupOpen ||
        isCreditCalcOpen ||
        isTaxDropdownPopupOpen ||
        isCountryPopupOpen ||
        isRegionPopupOpen;

    private void ToggleBranchPopup() { bool wasOpen = isBranchPopupOpen; CloseAllPopups(); isBranchPopupOpen = !wasOpen; }
    private void ToggleNestedPopup() { bool wasOpen = isNestedPopupOpen; CloseAllPopups(); isNestedPopupOpen = !wasOpen; }
    private void ToggleCurrencyPopup() { bool wasOpen = isCurrencyPopupOpen; CloseAllPopups(); isCurrencyPopupOpen = !wasOpen; }
    private void ToggleLedgerPopup() { bool wasOpen = isLedgerPopupOpen; CloseAllPopups(); isLedgerPopupOpen = !wasOpen; }
    private void ToggleDealTypePopup() { bool wasOpen = isDealTypePopupOpen; CloseAllPopups(); isDealTypePopupOpen = !wasOpen; }
    private void ToggleDealSidePopup() { bool wasOpen = isDealSidePopupOpen; CloseAllPopups(); isDealSidePopupOpen = !wasOpen; }
    private void ToggleCompPopup() { bool wasOpen = isCompPopupOpen; CloseAllPopups(); isCompPopupOpen = !wasOpen; }
    private void TogglePriceTierPopup() { bool wasOpen = isPriceTierPopupOpen; CloseAllPopups(); isPriceTierPopupOpen = !wasOpen; }
    private void ToggleDiscountTiersPopup() { bool wasOpen = isDiscountTiersPopupOpen; CloseAllPopups(); isDiscountTiersPopupOpen = !wasOpen; }
    private void ToggleCreditCalc() { bool wasOpen = isCreditCalcOpen; CloseAllPopups(); isCreditCalcOpen = !wasOpen; }
    private void ToggleTaxDropdownPopup() { bool wasOpen = isTaxDropdownPopupOpen; CloseAllPopups(); isTaxDropdownPopupOpen = !wasOpen; }
    private void ToggleCountryPopup() { bool wasOpen = isCountryPopupOpen; CloseAllPopups(); isCountryPopupOpen = !wasOpen; }
    private void ToggleRegionPopup() { bool wasOpen = isRegionPopupOpen; CloseAllPopups(); isRegionPopupOpen = !wasOpen; }

    private void CloseAllPopups()
    {
        isBranchPopupOpen = false;
        isNestedPopupOpen = false;
        isCurrencyPopupOpen = false;
        isLedgerPopupOpen = false;
        isDealTypePopupOpen = false;
        isDealSidePopupOpen = false;
        isCompPopupOpen = false;
        isPriceTierPopupOpen = false;
        isDiscountTiersPopupOpen = false;
        isCreditCalcOpen = false;
        isTaxDropdownPopupOpen = false;
        isCountryPopupOpen = false;
        isRegionPopupOpen = false;
        CloseAllTierCalcs();
    }

    private void SaveData() { }

    private List<string> priceTierList = new()
    {
        "سعر اخر تعامل",
        "سعر البيع",
        "التكلفة",
        "سعر العملاء المميزين"
    };

    public class DiscountTierItem
    {
        public string Name { get; set; } = "";
        public decimal Rate { get; set; } = 0;
        public bool IsCalcOpen { get; set; } = false;
    }

    private List<DiscountTierItem> discountTiersList = new()
    {
        new() { Name = "خصم توريدات الفئة أ (5%)", Rate = 5 },
        new() { Name = "خصم نقدي تجاري (2%)", Rate = 2 },
        new() { Name = "خصم تعجيل الدفع (3%)", Rate = 3 },
        new() { Name = "خصم كميات خاص", Rate = 0 }
    };

    private void SelectDiscountTier(string tierName)
    {
        supplierData.DiscountTier = tierName;
        isDiscountTiersPopupOpen = false;
    }

    private void RequestDeleteDiscountTier(DiscountTierItem tier)
    {
        tierPendingDelete = tier;
        isConfirmDeleteModalOpen = true;
    }

    private void ConfirmDeleteTier()
    {
        if (tierPendingDelete != null)
        {
            if (supplierData.DiscountTier == tierPendingDelete.Name)
            {
                supplierData.DiscountTier = "";
            }
            discountTiersList.Remove(tierPendingDelete);
            tierPendingDelete = null;
        }
        isConfirmDeleteModalOpen = false;
    }

    private void CancelDeleteTier()
    {
        tierPendingDelete = null;
        isConfirmDeleteModalOpen = false;
    }

    private void CloseAllTierCalcs()
    {
        foreach (var t in discountTiersList)
        {
            t.IsCalcOpen = false;
        }
        activeCalcTier = null;
    }

    private void ToggleTierCalc(DiscountTierItem tier)
    {
        bool wasOpen = tier.IsCalcOpen;
        CloseAllTierCalcs();
        tier.IsCalcOpen = !wasOpen;
        if (tier.IsCalcOpen)
        {
            activeCalcTier = tier;
            tierCalcDisplay = tier.Rate.ToString();
        }
    }

    private void OpenTierCalc(DiscountTierItem tier)
    {
        CloseAllTierCalcs();
        tier.IsCalcOpen = true;
        activeCalcTier = tier;
        tierCalcDisplay = tier.Rate.ToString();
    }

    private void TierCalcPress(string val)
    {
        if (tierCalcDisplay == "0" && val != ".") tierCalcDisplay = val;
        else tierCalcDisplay += val;
        ApplyTierCalcResult();
    }

    private void TierCalcAction(string action)
    {
        switch (action)
        {
            case "C":
            case "CE":
                tierCalcDisplay = "0";
                break;
            case "Back":
                if (tierCalcDisplay.Length > 1) tierCalcDisplay = tierCalcDisplay.Substring(0, tierCalcDisplay.Length - 1);
                else tierCalcDisplay = "0";
                break;
            case "-/+":
                if (tierCalcDisplay.StartsWith("-")) tierCalcDisplay = tierCalcDisplay.Substring(1);
                else if (tierCalcDisplay != "0") tierCalcDisplay = "-" + tierCalcDisplay;
                break;
            case "=":
                try
                {
                    var dt = new System.Data.DataTable();
                    var res = dt.Compute(tierCalcDisplay.Replace("x", "*"), "");
                    tierCalcDisplay = res?.ToString() ?? "0";
                }
                catch { }
                break;
        }
        ApplyTierCalcResult();
    }

    private void ApplyTierCalcResult()
    {
        if (activeCalcTier != null && decimal.TryParse(tierCalcDisplay, out var val))
        {
            activeCalcTier.Rate = val;
        }
    }


@page "/Expense"
@using SmartDemo.Components.Shared
@rendermode InteractiveServer

<div class="page-viewport" dir="rtl" @onclick="CloseAllPopups">
    <!-- Global transparent backdrop when any popup is open to catch outside clicks -->
    @if (IsAnyPopupOpen())
    {
        <div class="global-dropdown-backdrop" @onclick="CloseAllPopups" @onclick:stopPropagation></div>
    }

    <!-- Main Canvas -->
    <div class="main-canvas" @onclick:stopPropagation>
        <!-- Red Banner Title in Center -->
        <div class="expense-title-banner-root">
            <div class="expense-title-banner">
                <span>المصروفات</span>
            </div>
        </div>
        <!-- Top Header Area: Expense Type (Right) & Red Banner Title (Center) & Display Mode (Left) -->
        <div class="expense-header-row mb-3">
            <div class="expense-top-field pos-relative flex-column align-items-start gap-1">
                <span class="hdr-lbl">نوع المصروف</span>
                <div class="dropdown-anchor" style="width: 180px;">
                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleExpenseTypePopup">
                        <span class="combo-display-text">@selectedExpenseType</span>
                        <div class="combo-icons-inside ">
                            <span class="ico-swap">@GetSelectedExpenseIcon()</span>
                            <span class="combo-arrow">▼</span>
                        </div>
                    </div>

                    @if (isExpenseTypePopupOpen)
                    {
                        <div class="custom-dropdown-panel expense-type-dropdown-panel" @onclick:stopPropagation>
                            <div class="panel-scroll-content">
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف عام" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف عام", "📊")'>
                                    <span class="checkbox-label">مصروف عام</span>
                                    <span class="ms-auto text-primary">📊</span>
                                </div>
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف على الإعتماد" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف على الإعتماد", "🚢")'>
                                    <span class="checkbox-label">مصروف على الإعتماد</span>
                                    <span class="ms-auto text-primary">🚢</span>
                                </div>
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف على الأصول" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف على الأصول", "🏠")'>
                                    <span class="checkbox-label">مصروف على الأصول</span>
                                    <span class="ms-auto text-primary">🏠</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="expense-top-field pos-relative flex-column align-items-start gap-1">
                <span class="hdr-lbl">طريقة العرض</span>
                <div class="dropdown-anchor dropdown-anchor-width" style="width: 200px;">
                    <div class="custom-combo-trigger" @onclick:stopPropagation>
                        <span class="combo-display-text" @onclick="OpenSaveDisplayModeModal">@selectedDisplayMode</span>
                        <div class="combo-icons-inside combo-icons-inside-width">
                            <span class="combo-arrow" @onclick="OpenSaveDisplayModeModal" style="cursor: pointer;">▼</span>
                            <span class="btn-inside-plus" @onclick="OpenDisplayModeManagerModal" @onclick:stopPropagation style="cursor: pointer;">...</span>
                            <span class="combo-arrow" @onclick="ToggleThirdIconPopup" @onclick:stopPropagation style="cursor: pointer;">▼</span>
                        </div>
                    </div>

                    @if (isThirdIconPopupOpen)
                    {
                        <div class="custom-table-popup custom-accounts-dropdown" style="width: 280px; right: auto; left: 0;" @onclick:stopPropagation>
                            <div class="table-popup-header d-flex justify-content-between align-items-center">
                                <span class="col-name text-right">الاسم</span>
                                <button type="button" class="btn-table-close" @onclick="() => isThirdIconPopupOpen = false">✕</button>
                            </div>
                            <div class="table-popup-list" style="height: 180px;"></div>
                            <div class="table-popup-footer">
                                <button type="button" class="btn-table-close" @onclick="() => isThirdIconPopupOpen = false">✕</button>
                                <span class="resizer-dots">⠿</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Second Row: البيان -> الضريبة -> مركز التكلفة -> الاعتماد -> رقم المرجع # -->
        <div class="expense-filter-row mb-4">
            <div class="expense-filter-group flex-1">
                <span class="hdr-lbl">البيان</span>
                <input type="text" class="clean-input flex-1" @bind="expenseData.Statement" />
            </div>

            <div class="expense-filter-group-root">
                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">الضريبة</span>
                    <div class="dropdown-anchor" style="width: 150px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleTaxPopup">
                            <span class="combo-display-text">@expenseData.Tax</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isTaxPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">النسبة</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isTaxPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">مركز التكلفة</span>
                    <div class="dropdown-anchor" style="width: 160px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCostCenterPopup">
                            <span class="combo-display-text">@expenseData.CostCenter</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isCostCenterPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">الكود</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isCostCenterPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">الاعتماد</span>
                    <div class="dropdown-anchor" style="width: 150px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleApprovalPopup">
                            <span class="combo-display-text">@expenseData.Approval</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isApprovalPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">النسبة</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isApprovalPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group">
                    <span class="hdr-lbl">رقم المرجع #</span>
                    <input type="text" class="clean-input text-center" style="width: 110px;" @bind="expenseData.ReferenceNumber" />
                </div>
            </div>
        </div>

        <!-- 3. Table Section with Clean Inactive Rows -->
        <div class="section-with-blue-line mb-4">
            <div class="table-scroll-wrapper">
                <table class="item-details-table">
                    <thead>
                        <tr>
                            <th>الرقم</th>
                            <th>نوع المصروف</th>
                            <th>المبلغ</th>
                            <th>الشرح</th>
                            <th style="width: 32px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < expenseData.ExpenseRows.Count; i++)
                        {
                            var index = i;
                            var row = expenseData.ExpenseRows[i];
                            var isActive = index == activeRowIndex;
                            var isEven = index % 2 == 1;

                            <tr  class="@(isActive ? "active-grid-row" : (isEven ? "even-grid-row" : "odd-grid-row"))" @onclick="() => ActivateRow(index)">
                                <td>
                                    @if (isActive)
                                    {
                                        <input type="text" class="clean-input w-100 text-center active-cell-input" @value="row.Number" @value:after="() => OnRowInput(index)" @oninput="@(e => UpdateNumber(row, e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        <div class="table-static-cell text-center">@(!string.IsNullOrEmpty(row.Number) ? row.Number : "")</div>
                                    }
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <input type="text" class="clean-input w-100 text-center active-cell-input" @value="row.ExpenseType" @value:after="() => OnRowInput(index)" @oninput="@(e => UpdateExpenseType(row, e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        <div class="table-static-cell text-center">@row.ExpenseType</div>
                                    }
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <input type="number" class="clean-input w-100 text-center active-cell-input" @value="row.Amount" @value:after="() => OnRowInput(index)" @oninput="@(e => UpdateAmount(row, e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        <div class="table-static-cell text-center">@(row.Amount != 0 ? row.Amount.ToString() : "")</div>
                                    }
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <input type="text" class="clean-input w-100 active-cell-input" @value="row.Description" @value:after="() => OnRowInput(index)" @oninput="@(e => UpdateDescription(row, e.Value?.ToString()))" />
                                    }
                                    else
                                    {
                                        <div class="table-static-cell">@row.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="text-danger fw-bold" style="cursor: pointer;" @onclick="() => PromptDeleteRow(row)">✖</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom Total Row Banner -->
        <div class="expense-total-display-bar mb-4">
            <span class="total-number-display">0</span>
        </div>

        <!-- 4. Footer Section -->
        <div class="expense-footer-grid">
            <div class="expense-footer-right-side">
                <div class="field-entry-line pos-relative">
                    <span class="field-title">طريقة الدفع</span>
                    <div class="d-flex align-items-center gap-2 flex-1">
                        <div class="d-flex flex-column gap-1" style="width: 110px;">
                            <span class="sub-field-lbl">النوع</span>
                            <div class="dropdown-anchor pos-relative w-100">
                                <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="TogglePaymentMethodPopup">
                                    <span class="combo-display-text">@expenseData.PaymentMethod</span>
                                    <div class="combo-icons-inside">
                                        <span class="combo-arrow">▼</span>
                                        <span class="ico-swap">@GetSelectedPaymentIcon()</span>
                                    </div>
                                </div>

                                @if (isPaymentMethodPopupOpen)
                                {
                                    <div class="custom-dropdown-panel payment-method-dropdown-panel custom-payment-dropdown-styled" @onclick:stopPropagation>
                                        <div class="panel-scroll-content">
                                            <div class="panel-checkbox-row custom-payment-row @(expenseData.PaymentMethod == "خزينة" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("خزينة")'>
                                                <span class="checkbox-label">خزينة</span>
                                                <span class="payment-icon-slot">🛒</span>
                                            </div>
                                            <div class="panel-checkbox-row custom-payment-row @(expenseData.PaymentMethod == "بنك" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("بنك")'>
                                                <span class="checkbox-label">بنك</span>
                                                <span class="payment-icon-slot">🏠</span>
                                            </div>
                                            <div class="panel-checkbox-row custom-payment-row @(expenseData.PaymentMethod == "ماكينة نقاط البيع" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("ماكينة نقاط البيع")'>
                                                <span class="checkbox-label">ماكينة نقاط البيع</span>
                                                <span class="payment-icon-slot">💳</span>
                                            </div>
                                            <div class="panel-checkbox-row custom-payment-row @(expenseData.PaymentMethod == "عهدَة" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("عهدَة")'>
                                                <span class="checkbox-label">عهدَة</span>
                                                <span class="payment-icon-slot">🚶‍♂</span>
                                            </div>
                                            <div class="panel-checkbox-row custom-payment-row @(expenseData.PaymentMethod == "حساب استاذ" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("حساب استاذ")'>
                                                <span class="checkbox-label">حساب استاذ</span>
                                                <span class="payment-icon-slot">🏷️</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-1 flex-1">
                            <span class="sub-field-lbl">اسم الحساب</span>
                            <div class="dropdown-anchor pos-relative w-100">
                                <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="TogglePaymentGridPopup">
                                    <span class="combo-display-text">@expenseData.PaymentMethodName</span>
                                    <div class="combo-icons-inside">
                                        <span class="combo-arrow">▼</span>
                                    </div>
                                </div>

                                @if (isPaymentGridPopupOpen)
                                {
                                    <div class="custom-table-popup custom-accounts-dropdown payment-grid-popup-box" @onclick:stopPropagation>
                                        <div class="table-popup-header d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn-table-close" @onclick="() => isPaymentGridPopupOpen = false">✕</button>
                                            <div class="d-flex gap-3">
                                                <span class="col-code text-center" style="width: 70px;">النوع</span>
                                                <span class="col-name text-right" style="width: 140px;">اسم الحساب</span>
                                            </div>
                                        </div>
                                        <div class="table-popup-list" style="height: 150px;">
                                            <div class="supplier-row active-row d-flex justify-content-between align-items-center p-2 cursor-pointer" @onclick='() => SelectPaymentGridItem("1", "الخزينة الرئيسية", "EGP")'>
                                                <span class="col-code text-center" style="width: 70px;">EGP</span>
                                                <span class="col-name text-right" style="width: 140px;">الخزينة الرئيسية</span>
                                            </div>
                                        </div>
                                        <div class="table-popup-footer">
                                            <span class="resizer-dots">⠿</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-1 mt-3">
                            <span class="req-star">*</span>
                            <span class="small">@expenseData.PaymentTypeCode</span>
                            <span class="small font-weight-bold">EGP</span>
                        </div>
                    </div>
                </div>

                <div class="field-entry-line">
                    <span class="field-title">العمله</span>
                    <div class="d-flex align-items-center gap-2 flex-1">
                        <div class="dropdown-anchor flex-1 pos-relative">
                            <div class="custom-combo-trigger custom-combo-trigger-currency" @onclick:stopPropagation @onclick="ToggleCurrencyPopup">
                                <span class="combo-display-text">@expenseData.Currency</span>
                                <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                            </div>
                            @if (isCurrencyPopupOpen)
                            {
                                <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                    <div class="supplier-grid-header d-flex justify-content-between">
                                        <div class="col-code text-center" style="width: 80px;">الكود</div>
                                        <div class="col-name text-right flex-1">الاسم</div>
                                        <div class="col-action text-center" style="width: 80px;">المعامل</div>
                                    </div>
                                    <div class="supplier-grid-rows" style="max-height: 150px;">
                                        <div class="supplier-row active-row d-flex justify-content-between align-items-center" @onclick='() => SelectCurrency("EGP", "جنيه مصري", 1)'>
                                            <div class="col-code text-center" style="width: 80px;">EGP</div>
                                            <div class="col-name text-right flex-1">جنيه مصري</div>
                                            <div class="col-action text-center" style="width: 80px;">1</div>
                                        </div>
                                    </div>
                                    <div class="table-popup-footer">
                                        <button type="button" class="btn-table-close" @onclick="() => isCurrencyPopupOpen = false">✕</button>
                                        <span class="resizer-dots">⠿</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <input type="number" class="clean-input text-center" style="width: 90px;" @bind="expenseData.CurrencyRate" />
                        <span class="req-star">*</span>
                    </div>
                </div>

                <div class="field-entry-line">
                    <span class="field-title">الملاحظات</span>
                    <input type="text" class="clean-input flex-1" @bind="expenseData.Notes" />
                </div>
            </div>

            <div class="expense-footer-left-side">
                <div class="expense-summary-box">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>الاجمالي قبل الضريبة</span>
                        <span class="text-muted small">0</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>الضرائب :</span>
                        <span class="text-muted small">0</span>
                    </div>
                </div>

                <div class="floating-badge-left">
                    <span class="floating-badge-number">0</span>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 mt-3">
            <button type="button" class="btn-action-custom btn-save-custom" @onclick="SaveData">حفظ</button>
            <button type="button" class="btn-action-custom btn-print-custom" @onclick="OnSaveAndPrint">حفظ و طباعة</button>
            <button type="button" class="btn-action-custom btn-close-custom" @onclick="OnClose">إغلاق</button>
        </div>
    </div>
</div>

<!-- ================= MODALS SECTION ================= -->
<!-- Validation Center Dialog shown on Save / Save and Print -->
@if (isRequiredFieldsModalOpen)
{
    <div class="global-dropdown-backdrop" @onclick="CloseRequiredFieldsModal" @onclick:stopPropagation></div>
    <div class="exact-center-dialog-overlay" @onclick:stopPropagation>
        <div class="required-fields-modal-card">
            <div class="required-fields-header">
                <button type="button" class="required-fields-close-btn" @onclick="CloseRequiredFieldsModal">✕</button>
            </div>
            <div class="required-fields-body">
                <div class="required-fields-icon-wrapper">
                    <div class="required-fields-screen-icon">
                        <span class="screen-exclamation">!</span>
                    </div>
                    <div class="required-fields-stand-neck"></div>
                    <div class="required-fields-stand-base"></div>
                </div>
                <span class="required-fields-text">يجب ادخال جميع الحقول التي بجوارها نجمة حمراء</span>
      
            </div>
            <div class="required-fields-footer">
                <button type="button" class="btn-required-ok" @onclick="CloseRequiredFieldsModal">موافق</button>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal @bind-IsOpen="isConfirmDeleteModalOpen"
                    Message="هل تريد الحذف ؟"
                    OnConfirmed="ConfirmDeleteRow"
                    OnCancelled="CancelDeleteRow" />

<!-- EXACT PIXEL-PERFECT CENTER WINDOW FOR "هل تريد حفظ العرض؟" -->
@if (isSaveDisplayModeModalOpen)
{
    <div class="global-dropdown-backdrop" @onclick="CloseSaveDisplayModeModal" @onclick:stopPropagation></div>
    <div class="exact-center-dialog-overlay" @onclick:stopPropagation>
        <div class="save-display-mode-card">
            <!-- Header with top-left close button -->
            <div class="save-card-header">
                <button type="button" class="save-card-close-btn" @onclick="CloseSaveDisplayModeModal">✕</button>
            </div>

            <!-- Body: Question text and blue circular ? badge -->
            <div class="save-card-body">
                <div class="save-card-content">
                    <span class="save-card-question">هل تريد حفظ العرض؟</span>
                    <div class="save-card-circle-icon">?</div>
                </div>
            </div>

            <!-- Footer: Yes & No action buttons -->
            <div class="save-card-footer">
                <button type="button" class="btn-card-action btn-card-yes" @onclick="ConfirmSaveDisplayMode">نعم</button>
                <button type="button" class="btn-card-action btn-card-no" @onclick="CloseSaveDisplayModeModal">لا</button>
            </div>
        </div>
    </div>
}

<!-- EXACT CENTER WINDOW FOR DISPLAY MODE MANAGER (...) -->
@if (isDisplayModeManagerModalOpen)
{
    <div class="global-dropdown-backdrop" @onclick="CloseDisplayModeManagerModal" @onclick:stopPropagation></div>
    <div class="exact-center-dialog-overlay" @onclick:stopPropagation>
        <div class="exact-center-dialog">
            <div class="exact-center-dialog-header">
                <button type="button" class="exact-center-close-btn" @onclick="CloseDisplayModeManagerModal">✕</button>
            </div>
            <div class="exact-center-dialog-table-header">
                <table class="w-100 mb-0" style="border-collapse: collapse;">
                    <thead>
                        <tr>
                            <th class="text-right">الاسم</th>
                            <th class="text-center" style="width: 70px;">تعديل</th>
                            <th class="text-center" style="width: 70px;">حذف</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="exact-center-dialog-body">
                <table class="table w-100 mb-0" style="border-collapse: collapse;">
                    <tbody>
                        @for (int i = 1; i <= 15; i++)
                        {
                            <tr>
                                <td class="text-right">طريقة عرض رقم @i</td>
                                <td class="text-center" style="width: 70px;">
                                    <span class="text-primary fw-bold" style="cursor: pointer;">✏</span>
                                </td>
                                <td class="text-center" style="width: 70px;">
                                    <span class="text-danger fw-bold" style="cursor: pointer;">✖</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="exact-center-dialog-footer">

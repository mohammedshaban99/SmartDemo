@page "/Expense"
@using SmartDemo.Components.Shared
@rendermode InteractiveServer

<div class="page-viewport" dir="rtl" @onclick="CloseAllPopups">
    <!-- Global transparent backdrop when any popup is open to catch outside clicks -->
    @if (IsAnyPopupOpen())
    {
        <div class="global-dropdown-backdrop" @onclick="CloseAllPopups" @onclick:stopPropagation></div>
    }

    <!-- Main Canvas -->
    <div class="main-canvas" @onclick:stopPropagation>
        <!-- Top Header Area: Expense Type (Right) & Red Banner Title (Center) & Display Mode (Left) -->
        <div class="expense-header-row mb-3">
            <div class="expense-top-field pos-relative">
                <span class="hdr-lbl">نوع المصروف</span>
                <div class="dropdown-anchor" style="width: 180px;">
                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleExpenseTypePopup">
                        <span class="combo-display-text">@selectedExpenseType</span>
                        <div class="combo-icons-inside">
                            <span class="ico-swap">@GetSelectedExpenseIcon()</span>
                            <span class="combo-arrow">▼</span>
                        </div>
                    </div>

                    @if (isExpenseTypePopupOpen)
                    {
                        <div class="custom-dropdown-panel expense-type-dropdown-panel" @onclick:stopPropagation>
                            <div class="panel-scroll-content">
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف عام" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف عام", "📊")'>
                                    <span class="checkbox-label">مصروف عام</span>
                                    <span class="ms-auto text-primary">📊</span>
                                </div>
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف على الإعتماد" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف على الإعتماد", "🚢")'>
                                    <span class="checkbox-label">مصروف على الإعتماد</span>
                                    <span class="ms-auto text-primary">🚢</span>
                                </div>
                                <div class="panel-checkbox-row @(selectedExpenseType == "مصروف على الأصول" ? "active-row" : "")" @onclick='() => SelectExpenseType("مصروف على الأصول", "🏠")'>
                                    <span class="checkbox-label">مصروف على الأصول</span>
                                    <span class="ms-auto text-primary">🏠</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Red Banner Title in Center -->
            <div class="expense-title-banner">
                <span>المصروفات</span>
            </div>

            <div class="expense-top-field pos-relative">
                <span class="hdr-lbl">طريقة العرض</span>
                <div class="dropdown-anchor" style="width: 140px;">
                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleDisplayModePopup">
                        <span class="combo-display-text">@selectedDisplayMode</span>
                        <div class="combo-icons-inside">
                            <span class="btn-inside-plus">...</span>
                            <span class="combo-arrow">▼</span>
                        </div>
                    </div>

                    @if (isDisplayModePopupOpen)
                    {
                        <div class="custom-table-popup item-type-popup-size" style="width: 140px;" @onclick:stopPropagation>
                            <div class="table-popup-list">
                                <div class="table-popup-row @(selectedDisplayMode == "افتراضي" ? "active-row" : "")" @onclick='() => SelectDisplayMode("افتراضي")'>افتراضي</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Second Row: البيان -> الضريبة -> مركز التكلفة -> الاعتماد -> رقم المرجع # -->
        <div class="expense-filter-row mb-4">

            <div class="expense-filter-group flex-1">
                <span class="hdr-lbl">البيان</span>
                <input type="text" class="clean-input flex-1" @bind="expenseData.Statement" />
            </div>

            <div class="expense-filter-group-root">
                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">الضريبة</span>
                    <div class="dropdown-anchor" style="width: 150px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleTaxPopup">
                            <span class="combo-display-text">@expenseData.Tax</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isTaxPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">النسبة</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isTaxPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">مركز التكلفة</span>
                    <div class="dropdown-anchor" style="width: 160px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCostCenterPopup">
                            <span class="combo-display-text">@expenseData.CostCenter</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isCostCenterPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">الكود</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isCostCenterPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group pos-relative">
                    <span class="hdr-lbl">الاعتماد</span>
                    <div class="dropdown-anchor" style="width: 150px;">
                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleApprovalPopup">
                            <span class="combo-display-text">@expenseData.Approval</span>
                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                        </div>
                        @if (isApprovalPopupOpen)
                        {
                            <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                <div class="table-popup-header d-flex justify-content-between">
                                    <span class="col-name text-right">الاسم</span>
                                    <span class="col-code text-left">النسبة</span>
                                </div>
                                <div class="table-popup-list" style="height: 180px;"></div>
                                <div class="table-popup-footer">
                                    <button type="button" class="btn-table-close" @onclick="() => isApprovalPopupOpen = false">✕</button>
                                    <span class="resizer-dots">⠿</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="expense-filter-group">
                    <span class="hdr-lbl">رقم المرجع #</span>
                    <input type="text" class="clean-input text-center" style="width: 110px;" @bind="expenseData.ReferenceNumber" />
                </div>
            </div>
           


        </div>

        <!-- 3. Table Section with Corrected Column Ordering (Right-to-Left: الشرح -> المبلغ -> نوع المصروف -> الرقم) -->
        <div class="section-with-blue-line mb-4">
            <div class="table-scroll-wrapper">
                <table class="item-details-table">
                    <thead>
                        <tr>
                            <th style="width: 32px;"></th>
                            <th>الرقم</th>
                            <th>نوع المصروف</th>
                            <th>المبلغ</th>
                            <th>الشرح</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in expenseData.ExpenseRows)
                        {
                            <tr>
                                <td><span class="text-muted">▶</span></td>
                                <td><input type="text" class="clean-input w-100 text-center" @bind="row.Number" /></td>
                                <td><input type="text" class="clean-input w-100 text-center" @bind="row.ExpenseType" /></td>
                                <td><input type="number" class="clean-input w-100 text-center" @bind="row.Amount" /></td>
                                <td><input type="text" class="clean-input w-100" @bind="row.Description" /></td>
                             <td><button class="delete-icon-btn" type="button" @onclick="() => PromptDeleteRow(row)">✖</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Bottom Total Row Banner -->
        <div class="expense-total-display-bar mb-4">
            <span class="total-number-display">0</span>
        </div>

        <!-- 4. Footer Section: Right Side (Inputs), Left Side (Summary & Actions) -->
        <div class="expense-footer-grid">
            <div class="expense-footer-right-side">

                <div class="field-entry-line pos-relative">
                    <span class="field-title">طريقة الدفع</span>
                    <div class="d-flex align-items-center gap-2 flex-1">
                        <span class="req-star">*</span>
                        <input type="text" class="clean-input text-center" style="width: 50px;" @bind="expenseData.PaymentTypeCode" />
                        <div class="dropdown-anchor flex-1 pos-relative">
                            <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="TogglePaymentMethodPopup">
                                <span class="combo-display-text">@expenseData.PaymentMethod</span>
                                <div class="combo-icons-inside">
                                    <span class="combo-arrow">▼</span>
                                    <span class="ico-swap">🛒</span>
                                </div>
                            </div>

                            @if (isPaymentMethodPopupOpen)
                            {
                                <div class="custom-dropdown-panel payment-method-dropdown-panel" @onclick:stopPropagation>
                                    <div class="panel-scroll-content">
                                        <div class="panel-checkbox-row @(expenseData.PaymentMethod == "الخزينة الرئيسية" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("الخزينة الرئيسية")'>
                                            <span class="checkbox-label">الخزينة الرئيسية</span>
                                            <span class="ms-auto text-primary">🛒</span>
                                        </div>
                                        <div class="panel-checkbox-row @(expenseData.PaymentMethod == "بنك" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("بنك")'>
                                            <span class="checkbox-label">بنك</span>
                                            <span class="ms-auto text-primary">🏠</span>
                                        </div>
                                        <div class="panel-checkbox-row @(expenseData.PaymentMethod == "ماكينة نقاط البيع" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("ماكينة نقاط البيع")'>
                                            <span class="checkbox-label">ماكينة نقاط البيع</span>
                                            <span class="ms-auto text-primary">💳</span>
                                        </div>
                                        <div class="panel-checkbox-row @(expenseData.PaymentMethod == "عهدَة" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("عهدَة")'>
                                            <span class="checkbox-label">عهدَة</span>
                                            <span class="ms-auto text-primary">🚶‍♂️</span>
                                        </div>
                                        <div class="panel-checkbox-row @(expenseData.PaymentMethod == "حساب استاذ" ? "active-row" : "")" @onclick='() => SelectPaymentMethod("حساب استاذ")'>
                                            <span class="checkbox-label">حساب استاذ</span>
                                            <span class="ms-auto text-primary">🏷️</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="field-entry-line">
                    <span class="field-title">العمله</span>
                    <div class="d-flex align-items-center gap-2 flex-1">
                       
                        <div class="dropdown-anchor flex-1 pos-relative">
                            <div class="custom-combo-trigger custom-combo-trigger-currency" @onclick:stopPropagation @onclick="ToggleCurrencyPopup">
                                <span class="combo-display-text">@expenseData.Currency</span>
                                <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                            </div>
                            @if (isCurrencyPopupOpen)
                            {
                                <div class="custom-table-popup custom-accounts-dropdown" @onclick:stopPropagation>
                                    <div class="supplier-grid-header d-flex justify-content-between">
                                        <div class="col-code text-center" style="width: 80px;">الكود</div>
                                        <div class="col-name text-right flex-1">الاسم</div>
                                        <div class="col-action text-center" style="width: 80px;">المعامل</div>
                                    </div>
                                    <div class="supplier-grid-rows" style="max-height: 150px;">
                                        <div class="supplier-row active-row d-flex justify-content-between align-items-center" @onclick='() => SelectCurrency("EGP", "جنيه مصري", 1)'>
                                            <div class="col-code text-center" style="width: 80px;">EGP</div>
                                            <div class="col-name text-right flex-1">جنيه مصري</div>
                                            <div class="col-action text-center" style="width: 80px;">1</div>
                                        </div>
                                    </div>
                                    <div class="table-popup-footer">
                                        <button type="button" class="btn-table-close" @onclick="() => isCurrencyPopupOpen = false">✕</button>
                                        <span class="resizer-dots">⠿</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <input type="number" class="clean-input text-center" style="width: 90px;" @bind="expenseData.CurrencyRate" />
                        <span class="req-star">*</span>
                    </div>
                </div>

                <div class="field-entry-line">
                    <span class="field-title">الملاحظات</span>
                    <input type="text" class="clean-input flex-1" @bind="expenseData.Notes" />
                </div>
            </div>

            <div class="expense-footer-left-side">
                <div class="expense-summary-box">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold small">الاجمالي قبل الضريبة</span>
                        <span class="text-muted small">0</span>                    
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold small">الضرائب :</span>
                        <span class="text-muted small">0</span>                   
                    </div>
                </div>

              
            </div>
          
        </div>
        <div class="d-flex align-items-center gap-2 mt-3">
            <button type="button" class="btn-action-custom btn-save-custom" @onclick="SaveData">حفظ</button>
            <button type="button" class="btn-action-custom btn-print-custom" @onclick="OnSaveAndPrint">حفظ و طباعة</button>
            <button type="button" class="btn-action-custom btn-close-custom" @onclick="OnClose">إغلاق</button>
        </div>
    </div>
</div>

<!-- ================= MODALS SECTION ================= -->
<ConfirmDeleteModal @bind-IsOpen="isConfirmDeleteModalOpen"
                    Message="هل تريد الحذف ؟"
                    OnConfirmed="ConfirmDeleteRow"
                    OnCancelled="CancelDeleteRow" />

@code {
    private string selectedDisplayMode = "";
    private string selectedExpenseType = "مصروف عام";
    private bool isExpenseTypePopupOpen = false;
    private bool isDisplayModePopupOpen = false;
    private bool isApprovalPopupOpen = false;
    private bool isCostCenterPopupOpen = false;
    private bool isTaxPopupOpen = false;
    private bool isPaymentMethodPopupOpen = false;
    private bool isCurrencyPopupOpen = false;

    private bool isConfirmDeleteModalOpen = false;
    private ExpenseRowModel? rowPendingDelete;

    private ExpenseModel expenseData = new()
    {
        ReferenceNumber = "",
        Approval = "",
        CostCenter = "",
        Tax = "",
        Statement = "",
        PaymentMethod = "الخزينة الرئيسية",
        PaymentTypeCode = "0",
        CurrencyRate = 1,
        Currency = "EGP",
        Notes = "",
        ExpenseRows = new List<ExpenseRowModel>
        {
            new() { Number = "1", ExpenseType = "", Amount = 0, Description = "" }
        }
    };

    private bool IsAnyPopupOpen() =>
        isExpenseTypePopupOpen ||
        isDisplayModePopupOpen ||
        isApprovalPopupOpen ||
        isCostCenterPopupOpen ||
        isTaxPopupOpen ||
        isPaymentMethodPopupOpen ||
        isCurrencyPopupOpen;

    private void CloseAllPopups()
    {
        isExpenseTypePopupOpen = false;
        isDisplayModePopupOpen = false;
        isApprovalPopupOpen = false;
        isCostCenterPopupOpen = false;
        isTaxPopupOpen = false;
        isPaymentMethodPopupOpen = false;
        isCurrencyPopupOpen = false;
    }

    private string GetSelectedExpenseIcon() => selectedExpenseType switch
    {
        "مصروف عام" => "📊",
        "مصروف على الإعتماد" => "🚢",
        "مصروف على الأصول" => "🏠",
        _ => "📊"
    };

    private void ToggleExpenseTypePopup()
    {
        bool wasOpen = isExpenseTypePopupOpen;
        CloseAllPopups();
        isExpenseTypePopupOpen = !wasOpen;
    }

    private void SelectExpenseType(string type, string icon)
    {
        selectedExpenseType = type;
        isExpenseTypePopupOpen = false;
    }

    private void ToggleDisplayModePopup()
    {
        bool wasOpen = isDisplayModePopupOpen;
        CloseAllPopups();
        isDisplayModePopupOpen = !wasOpen;
    }

    private void SelectDisplayMode(string mode)
    {
        selectedDisplayMode = mode;
        isDisplayModePopupOpen = false;
    }

    private void ToggleApprovalPopup() { bool wasOpen = isApprovalPopupOpen; CloseAllPopups(); isApprovalPopupOpen = !wasOpen; }
    private void ToggleCostCenterPopup() { bool wasOpen = isCostCenterPopupOpen; CloseAllPopups(); isCostCenterPopupOpen = !wasOpen; }
    private void ToggleTaxPopup() { bool wasOpen = isTaxPopupOpen; CloseAllPopups(); isTaxPopupOpen = !wasOpen; }
    private void TogglePaymentMethodPopup() { bool wasOpen = isPaymentMethodPopupOpen; CloseAllPopups(); isPaymentMethodPopupOpen = !wasOpen; }
    private void ToggleCurrencyPopup() { bool wasOpen = isCurrencyPopupOpen; CloseAllPopups(); isCurrencyPopupOpen = !wasOpen; }

    private void SelectPaymentMethod(string method)
    {
        expenseData.PaymentMethod = method;
        isPaymentMethodPopupOpen = false;
    }

    private void SelectCurrency(string code, string name, decimal rate)
    {
        expenseData.Currency = code;
        expenseData.CurrencyRate = rate;
        isCurrencyPopupOpen = false;
    }

    private void PromptDeleteRow(ExpenseRowModel row)
    {
        rowPendingDelete = row;
        isConfirmDeleteModalOpen = true;
    }

    private void ConfirmDeleteRow()
    {
        if (rowPendingDelete != null && expenseData.ExpenseRows.Count > 1)
        {
            expenseData.ExpenseRows.Remove(rowPendingDelete);
        }
        rowPendingDelete = null;
        isConfirmDeleteModalOpen = false;
    }

    private void CancelDeleteRow()
    {
        rowPendingDelete = null;
        isConfirmDeleteModalOpen = false;
    }

    private void SaveData() { }
    private void OnSaveAndPrint() { }
    private void OnClose() { }

    public class ExpenseModel
    {
        public string ReferenceNumber { get; set; } = "";
        public string Approval { get; set; } = "";
        public string CostCenter { get; set; } = "";
        public string Tax { get; set; } = "";
        public string Statement { get; set; } = "";
        public string PaymentMethod { get; set; } = "";
        public string PaymentTypeCode { get; set; } = "0";
        public decimal CurrencyRate { get; set; } = 1;
        public string Currency { get; set; } = "EGP";
        public string Notes { get; set; } = "";
        public List<ExpenseRowModel> ExpenseRows { get; set; } = new();
    }

    public class ExpenseRowModel
    {
        public string Number { get; set; } = "";
        public string ExpenseType { get; set; } = "";
        public decimal Amount { get; set; }
        public string Description { get; set; } = "";
    }
}

<style>
    .page-viewport {
        background-color: #f1f3f6;
        min-height: 100vh;
        width: 100%;
        padding: 30px 40px;
        box-sizing: border-box;
        overflow: auto;
        display: flex;
        position: relative;
        direction: rtl;
    }

    .pos-relative {
        position: relative;
    }

    .global-dropdown-backdrop {
        position: fixed;
        inset: 0;
        background: transparent;
        z-index: 1500;
    }

    .main-canvas {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
    }

    .expense-title-banner {
        background-color: #d9534f;
        color: #ffffff;
        text-align: center;
        padding: 6px 30px;
        font-weight: bold;
        font-size: 1rem;
        border-radius: 4px;
        flex: 0 0 auto;
        min-width: 250px;
    }

    .expense-header-row {
        border-top: solid 1px #D9534F;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .expense-top-field {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .expense-filter-row {
        display: flex;
        align-items: center;
        gap: 15px;
        background: transparent;
        justify-content: space-between;
    }

    .expense-filter-group-root{
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }
    .expense-filter-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .expense-total-display-bar {
        text-align: center;
    }

    .total-number-display {
        font-size: 1.25rem;
        font-weight: bold;
        color: #333;
    }

    .expense-footer-grid {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
        margin-top: 20px;
    }

    .expense-footer-right-side {
        width: 450px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .expense-footer-left-side {
        width: 320px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-action-custom {
        padding: 7px 12px;
        font-size: 0.9rem;
        width: 170px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #ced4da;
        text-align: center;
    }

    .btn-close-custom {
        background-color: #ffffff;
        color: #333;
    }

    .btn-print-custom {
        background-color: #ffffff;
        color: #333;
    }

    .btn-save-custom {
        background-color: #ffffff;
    }

    .custom-dropdown-panel {
        position: absolute;
        top: 34px !important;
        right: 0 !important;
        left: 0 !important;
        width: 100% !important;
        background: #ffffff;
        border: 1px solid #ced4da;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
        border-radius: 3px;
        z-index: 2000;
        box-sizing: border-box;
    }

    .panel-scroll-content {
        max-height: 220px;
        overflow-y: auto;
    }

    .panel-checkbox-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        font-size: 0.83rem;
        cursor: pointer;
        text-align: right;
        border-bottom: 1px solid #f2f2f2;
    }

        .panel-checkbox-row:hover {
            background-color: #e9f2ff;
        }

    .clean-input {
        border: 1px solid transparent;
        border-bottom: 3px solid transparent;
        border-radius: 3px;

    private bool isCreditCalcOpen = false;
    private bool isTaxDropdownPopupOpen = false;
    private bool isCountryPopupOpen = false;
    private bool isRegionPopupOpen = false;

    private string calcDisplay = "80000";

    /* Confirmation Modal States */

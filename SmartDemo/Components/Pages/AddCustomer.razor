@page "/AddCustomer"
@rendermode InteractiveServer

<div class="page-viewport" dir="rtl" @onclick="CloseAllPopups">
    <!-- Global transparent backdrop when any popup is open to catch outside clicks -->
    @if (IsAnyPopupOpen())
    {
        <div class="global-dropdown-backdrop" @onclick="CloseAllPopups" @onclick:stopPropagation></div>
    }

    <div class="main-canvas" @onclick:stopPropagation>
        <!-- 1. Dedicated Right Column: Avatar & Active Status Checkbox -->
        <aside class="avatar-sidebar">
            <div class="image-square avatar-square">
                <span class="user-avatar-icon">👤</span>
            </div>
            <div class="active-check-group">
                <input type="checkbox" id="chkActive" class="chk-box" @bind="customerData.IsActive" />
                <label for="chkActive" class="small-chk-label">نشط</label>
            </div>
        </aside>

        <!-- 2. Form & Tabs Workspace Area -->
        <main class="form-content-area">
            <!-- Top Header Master Bar -->
            <div class="header-master-grid">

                <!-- Orange Vertical Divider -->
                <div class="orange-divider-line"></div>

                <!-- Section Labels -->
                <div class="labels-column">
                    <div class="label-row-cell"><span class="hdr-lbl">الرقم</span></div>
                    <div class="label-row-cell"><span class="hdr-lbl">الاسم</span></div>
                    <div class="label-row-cell"><span class="hdr-lbl">الرصيد الإفتتاحي</span></div>
                </div>

                <!-- Form Input Controls -->
                <div class="controls-column">
                    <!-- Row 1: Code & Verification Check -->
                    <div class="form-row-compact">
                        <input type="text" class="clean-input supplier-code-input text-center" @bind="customerData.CustomerCode" />
                        <span class="req-star">*</span>
                        <span class="text-success fs-5 ms-1 verification-icon" title="رقم صحيح">✓</span>
                    </div>

                    <!-- Row 2: Name Input -->
                    <div class="form-row-compact">
                        <input type="text" class="clean-input flex-1 supplier-name-input" @bind="customerData.Name" placeholder="أدخل اسم العميل..." />
                        <span class="req-star">*</span>
                    </div>

                    <!-- Row 3: Opening Balance Date & Value -->
                    <div class="form-row-compact">
                        <input type="number" class="clean-input text-center balance-amount-input" @bind="customerData.OpeningBalanceAmount" />
                        <span class="small text-muted balance-sep-word">في</span>
                        <input type="date" class="clean-input text-center balance-date-input" @bind="customerData.OpeningBalanceDate" />
                    </div>
                </div>

                <!-- Save Button -->
                <div class="save-cell">
                    <button class="btn-primary-custom" @onclick="SaveData" type="button">حفظ</button>
                </div>

                <!-- Left Photo Placeholder Box -->
                <div class="image-left-placeholder">
                    <span class="text-muted fs-6">الصورة</span>
                </div>

            </div>

            <!-- Navigation Tabs Bar -->
            <div class="tab-strip-bar">
                <button class="strip-tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1" type="button">بيانات الحساب</button>
                <button class="strip-tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2" type="button">الضرائب</button>
                <button class="strip-tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => activeTab = 3" type="button">بيانات الإتصال</button>
                <button class="strip-tab-btn @(activeTab == 4 ? "active" : "")" @onclick="() => activeTab = 4" type="button">بيانات إضافية</button>
                <button class="strip-tab-btn @(activeTab == 5 ? "active" : "")" @onclick="() => activeTab = 5" type="button">الانترنت</button>
            </div>

            <!-- Tab 1: بيانات الحساب -->
            @if (activeTab == 1)
            {
                <div class="tab-content-seamless">

                    <!-- 1. التصنيف -->
                    <div class="section-title-header">
                        <span class="fw-bold fs-6 text-dark section-header-title">التصنيف</span>
                    </div>

                    <div class="section-with-blue-line mb-4">
                        <div class="full-width-stack">
                            <!-- اسم الفرع -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">اسم الفرع</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleBranchPopup">
                                        <span class="combo-display-text">@customerData.Branch</span>
                                        <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                    </div>
                                    @if (isBranchPopupOpen)
                                    {
                                        <div class="custom-supplier-grid-panel-advanced" style="width:100%; left: 0; right: auto;" @onclick:stopPropagation>
                                            <div class="supplier-grid-header">
                                                <div class="col-code">الكود</div>
                                                <div class="col-name">الاسم</div>
                                            </div>
                                            <div class="supplier-grid-rows" style="max-height: 200px;">
                                                @foreach (var b in mockBranchList)
                                                {
                                                    <div class="supplier-row @(customerData.Branch == b.Name ? "active-row" : "")" @onclick="() => SelectBranch(b.Name)">
                                                        <div class="col-code">@b.Code</div>
                                                        <div class="col-name">@b.Name</div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isBranchPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                                <div class="d-flex align-items-center gap-1 ms-3">
                                    <input type="checkbox" id="chkAllBranches" class="chk-box" />
                                    <label for="chkAllBranches" class="small text-muted" style="white-space: nowrap;">كل الفروع</label>
                                </div>
                            </div>

                            <!-- يوجد بداخل -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">يوجد بداخل</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleNestedPopup">
                                        <span class="combo-display-text">@customerData.NestedWithin</span>
                                        <div class="combo-icons-inside">
                                            <button class="btn-inside-plus" type="button" @onclick:stopPropagation @onclick="OpenNestedModal" title="إضافة تصنيف جديد">+</button>
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>
                                    @if (isNestedPopupOpen)
                                    {
                                        <div class="custom-supplier-grid-panel-advanced" style="width: 100%; left: 0; right: auto;" @onclick:stopPropagation>
                                            <div class="supplier-grid-header">
                                                <div class="col-name w-100">الاسم</div>
                                            </div>
                                            <div class="supplier-grid-rows" style="max-height: 220px;">
                                                @foreach (var node in mockNestedTree)
                                                {
                                                    @RenderNestedTreeNode(node, name => { customerData.NestedWithin = name; isNestedPopupOpen = false; })
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isNestedPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- العملة الافتراضية -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">العملة الافتراضية</span>
                                <div class="d-flex align-items-center gap-2 flex-control-wrap">
                                    <input type="number" class="clean-input text-center" style="width: 75px;" @bind="customerData.ExchangeRate" />
                                    <div class="dropdown-anchor flex-1">
                                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCurrencyPopup">
                                            <span class="combo-display-text">@customerData.Currency</span>
                                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                        </div>
                                        @if (isCurrencyPopupOpen)
                                        {
                                            <div class="custom-supplier-grid-panel-advanced" style="left: 0; right: auto;" @onclick:stopPropagation>
                                                <div class="supplier-grid-header">
                                                    <div class="col-code">الكود</div>
                                                    <div class="col-name">الاسم</div>
                                                    <div class="col-code">المعامل</div>
                                                </div>
                                                <div class="supplier-grid-rows" style="max-height: 200px;">
                                                    @foreach (var c in mockCurrencyList)
                                                    {
                                                        <div class="supplier-row @(customerData.Currency == c.Code ? "active-row" : "")" @onclick="() => SelectCurrency(c)">
                                                            <div class="col-code">@c.Code</div>
                                                            <div class="col-name">@c.Name</div>
                                                            <div class="col-code">@c.Rate</div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="table-popup-footer">
                                                    <button type="button" class="btn-table-close" @onclick="() => isCurrencyPopupOpen = false">✕</button>
                                                    <span class="resizer-dots">⠿</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- حساب الاستاذ -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">حساب الاستاذ</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleLedgerPopup">
                                        <span class="combo-display-text">@customerData.LedgerAccount</span>
                                        <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                    </div>
                                    @if (isLedgerPopupOpen)
                                    {
                                        <div class="custom-table-popup accounts-tree-dropdown-panel" style="left: 0; right: auto; width:100%;" @onclick:stopPropagation>
                                            <div class="supplier-grid-header">
                                                <div class="col-code text-center" style="width: 90px;">الكود</div>
                                                <div class="col-name text-right">الاسم</div>
                                            </div>
                                            <div class="supplier-grid-rows" style="max-height: 240px;">
                                                @foreach (var node in accountsTreeList)
                                                {
                                                    @RenderAccountsTreeNode(node, customerData.LedgerAccount, name => { customerData.LedgerAccount = name; isLedgerPopupOpen = false; })
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isLedgerPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. سياسة التعامل -->
                    <div class="section-title-header">
                        <span class="fw-bold fs-6 text-dark section-header-title">سياسة التعامل</span>
                    </div>

                    <div class="section-with-blue-line mb-4">
                        <div class="full-width-stack">
                            <!-- التعامل الافتراضي -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">التعامل الافتراضي</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleDealTypePopup">
                                        <div class="d-flex align-items-center gap-2 flex-1">
                                            <span class="combo-display-text text-start">@customerData.DefaultDealType</span>
                                            <span class="badge-signal-bars">📶</span>
                                        </div>
                                        <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                    </div>
                                    @if (isDealTypePopupOpen)
                                    {
                                        <div class="custom-dropdown-panel" style="width: 100%; left: 0; right: auto;" @onclick:stopPropagation>
                                            <div class="panel-scroll-content">
                                                @foreach (var dt in new[] { "كاش", "أجل", "قسط" })
                                                {
                                                    <div class="panel-checkbox-row justify-content-start gap-3" @onclick="() => { customerData.DefaultDealType = dt; isDealTypePopupOpen = false; }">
                                                        <span>@dt</span>
                                                        <span>📶</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- حد الإئتمان -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">حد الإئتمان</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCreditCalc">
                                        <span class="combo-display-text text-center">@customerData.CreditLimit</span>
                                        <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                    </div>
                                    @if (isCreditCalcOpen)
                                    {
                                        <div class="calc-popup-box calc-desktop-popup" style="left: 0; right: auto;" @onclick:stopPropagation>
                                            <div class="calc-screen">@calcDisplay</div>
                                            <div class="calc-grid">
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("/")'>/</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("sqrt")'>sqrt</button>
                                                <button type="button" class="calc-btn calc-op"></button>
                                                <button type="button" class="calc-btn calc-op" @onclick="CalcBack">Back</button>
                                                <button type="button" class="calc-btn calc-op" @onclick="CalcClearEntry">CE</button>
                                                <button type="button" class="calc-btn calc-op" @onclick="CalcClear">C</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("*")'>*</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("%")'>%</button>
                                                <button type="button" class="calc-btn calc-mem">MC</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("7")'>7</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("8")'>8</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("9")'>9</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("-")'>-</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("x/1")'>x/1</button>
                                                <button type="button" class="calc-btn calc-mem">MR</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("4")'>4</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("5")'>5</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("6")'>6</button>
                                                <button type="button" class="calc-btn calc-op" @onclick='() => CalcPress("+")'>+</button>
                                                <button type="button" class="calc-btn calc-op" @onclick="CalcEquals">=</button>
                                                <button type="button" class="calc-btn calc-mem">MS</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("1")'>1</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("2")'>2</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("3")'>3</button>
                                                <button type="button" class="calc-btn calc-mem span-col-2"></button>
                                                <button type="button" class="calc-btn calc-mem">+M</button>
                                                <button type="button" class="calc-btn calc-op" @onclick="CalcToggleSign">-/+</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress("0")'>0</button>
                                                <button type="button" class="calc-btn" @onclick='() => CalcPress(".")'>.</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- جهة التعامل -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">جهة التعامل</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleDealSidePopup">
                                        <span class="combo-display-text">@customerData.DealSide</span>
                                        <div class="combo-icons-inside">
                                            <button class="btn-inside-plus" type="button" @onclick:stopPropagation @onclick="OpenDealSideModal" title="إضافة جهة تعامل">+</button>
                                            <span class="combo-arrow">▼</span>
                                        </div>
                                    </div>
                                    @if (isDealSidePopupOpen)
                                    {
                                        <div class="custom-table-popup" style="width: 100%; left: 0; right: auto;" @onclick:stopPropagation>
                                            <div class="table-popup-header">الاسم</div>
                                            <div class="table-popup-list">
                                                @foreach (var ds in dealSideList)
                                                {
                                                    <div class="table-popup-row @(customerData.DealSide == ds ? "active-row" : "")" @onclick="() => { customerData.DealSide = ds; isDealSidePopupOpen = false; }">@ds</div>
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isDealSidePopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>

                            <!-- الحساب المكمل -->
                            <div class="field-entry-line pos-relative">
                                <span class="field-title">الحساب المكمل</span>
                                <div class="dropdown-anchor flex-control-wrap">
                                    <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleCompPopup">
                                        <span class="combo-display-text">@customerData.ComplementaryAccount</span>
                                        <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                    </div>
                                    @if (isCompPopupOpen)
                                    {
                                        <div class="custom-table-popup accounts-tree-dropdown-panel" style="left: 0; right: auto; width:100%;" @onclick:stopPropagation>
                                            <div class="supplier-grid-header">
                                                <div class="col-code text-center" style="width: 90px;">الكود</div>
                                                <div class="col-name text-right">الاسم</div>
                                            </div>
                                            <div class="supplier-grid-rows" style="max-height: 240px;">
                                                @foreach (var node in accountsTreeList)
                                                {
                                                    @RenderAccountsTreeNode(node, customerData.ComplementaryAccount, name => { customerData.ComplementaryAccount = name; isCompPopupOpen = false; })
                                                }
                                            </div>
                                            <div class="table-popup-footer">
                                                <button type="button" class="btn-table-close" @onclick="() => isCompPopupOpen = false">✕</button>
                                                <span class="resizer-dots">⠿</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="req-star me-1">*</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. الاضافات -->
                    <div class="section-title-header">
                        <span class="fw-bold fs-6 text-dark section-header-title">الاضافات</span>
                    </div>

                    <div class="section-with-blue-line">
                        <div class="two-column-form-grid align-items-start">
                            <div class="form-side-column">
                                <div class="field-entry-line">
                                    <span class="field-title">شريحة الاسعار</span>
                                    <select class="clean-input flex-control-wrap" @bind="customerData.PriceTier">
                                        @foreach (var tier in mockPriceTiers)
                                        {
                                            <option value="@tier">@tier</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-entry-line">
                                    <span class="field-title">شروط الدفع</span>
                                    <select class="clean-input flex-control-wrap" @bind="customerData.PaymentTerms">
                                        @foreach (var term in mockPaymentTerms)
                                        {
                                            <option value="@term">@term</option>
                                        }
                                    </select>
                                </div>

                                <!-- شرائح الخصم (طريقة العرض التفاعلية المطابقة للموردين) -->
                                <div class="field-entry-line pos-relative">
                                    <span class="field-title">شرائح الخصم</span>
                                    <div class="dropdown-anchor flex-control-wrap">
                                        <div class="custom-combo-trigger" @onclick:stopPropagation @onclick="ToggleDiscountTiersPopup">
                                            <span class="combo-display-text">@customerData.DiscountTier</span>
                                            <div class="combo-icons-inside"><span class="combo-arrow">▼</span></div>
                                        </div>
                                        @if (isDiscountTiersPopupOpen)
                                        {
                                            <div class="custom-supplier-grid-panel-advanced discount-tiers-popup-box" style="left: 0; right: auto; width:100%" @onclick:stopPropagation>
                                                <div class="supplier-grid-header">
                                                    <div class="col-act" style="width: 35px;"></div>
                                                    <div class="col-name text-right">الاسم</div>
                                                    <div class="col-code text-center" style="width: 100px;">النسبة</div>
                                                    <div class="col-act" style="width: 30px;"></div>
                                                </div>
                                                <div class="supplier-grid-rows" style="max-height: 220px;">
                                                    @foreach (var dt in discountTiersList)
                                                    {
                                                        <div class="supplier-row align-items-center @(customerData.DiscountTier == dt.Name ? "active-row" : "")"
                                                             @onclick="() => SelectDiscountTier(dt.Name)">
                                                            <div class="col-name text-right pe-2">@dt.Name</div>
                                                            <div class="col-code pos-relative" style="width: 100px;" @onclick:stopPropagation>
                                                                <div class="rate-combo-wrapper">
                                                                    <span class="combo-arrow me-1">▼</span>
                                                                    <input type="number" class="clean-input text-center p-0 flex-1 border-0"
                                                                           @bind="dt.Rate" @onclick:stopPropagation />
                                                                </div>
                                                            </div>
                                                            <div class="col-act text-muted small text-center" style="width: 30px;">✎</div>
                                                            <div class="col-act text-center" style="width: 35px;" @onclick:stopPropagation @onclick="() => RequestDeleteDiscountTier(dt)">
                                                                <span class="delete-icon-cross">✕</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="table-popup-footer">
                                                    <button type="button" class="btn-table-close" @onclick="() => isDiscountTiersPopupOpen = false">✕</button>
                                                    <span class="resizer-dots">⠿</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="field-entry-line">
                                    <span class="field-title">مندوب المبيعات</span>
                                    <select class="clean-input flex-control-wrap" @bind="customerData.SalesRepresentative">
                                        @foreach (var rep in mockSalesReps)
                                        {
                                            <option value="@rep">@rep</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-entry-line">
                                    <span class="field-title">مركز التكلفة</span>
                                    <select class="clean-input flex-control-wrap"><option>الفرع الرئيسي - الإدارة العامة</option></select>
                                </div>
                            </div>

                            <!-- شركات التأمين Section Layout -->
                            <div class="form-side-column justify-content-start" style="position: relative;">
                                <div class="insurance-card-box">
                                    <div class="insurance-card-header">
                                        <span>شركات التأمين</span>
                                        <div class="d-flex align-items-center gap-2">

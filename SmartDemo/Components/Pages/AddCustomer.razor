private void CalcPress(string val) { if (calcDisplay == "0" && val != ".") calcDisplay = val; else calcDisplay += val; }
private void CalcClear() { calcDisplay = "0"; }
private void CalcClearEntry() { calcDisplay = "0"; }
private void CalcBack() { if (calcDisplay.Length > 1) calcDisplay = calcDisplay.Substring(0, calcDisplay.Length - 1); else calcDisplay = "0"; }
private void CalcToggleSign() { if (calcDisplay.StartsWith("-")) calcDisplay = calcDisplay.Substring(1); else if (calcDisplay != "0") calcDisplay = "-" + calcDisplay; }
private void CalcEquals()
{
    try
    {
        var dt = new System.Data.DataTable();
        var res = dt.Compute(calcDisplay.Replace("x", "*"), "");
        calcDisplay = res?.ToString() ?? "0";
        if (decimal.TryParse(calcDisplay, out var d)) customerData.CreditLimit = d;
    }
    catch { }
}


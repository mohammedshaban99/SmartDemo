        public string Branch { get; set; } = "الفرع الرئيسي";
        public bool AllBranches { get; set; } = false;
        public string ParentGroup { get; set; } = "";
        public string ShowWith { get; set; } = "الكل";
        public string Notes { get; set; } = "";
        public bool IsActive { get; set; } = true;
    }
    private NestedGroupModel newNestedModel = new();

    /* Deal Side Modal State */
    private bool isDealSideModalOpen = false;
    private bool isDealSideNestedPopupOpen = false;
    private bool isDealSideCurrencyPopupOpen = false;
    private bool isDealSideLedgerPopupOpen = false;

    public class DealSideModel
    {
        public string Name { get; set; } = "";
        public string NestedUnder { get; set; } = "الكل";
        public bool IsActive { get; set; } = true;
        public string DefaultCurrency { get; set; } = "EGP";
        public string LedgerAccount { get; set; } = "";
    }
    private DealSideModel newDealSideModel = new();

    public class NestedOptionItem { public string Name { get; set; } = ""; public string Icon { get; set; } = ""; }
    private List<NestedOptionItem> nestedOptionsList = new()
    {
        new() { Name = "الكل", Icon = "🧑‍💼" },
        new() { Name = "العملاء", Icon = "👥" },
        new() { Name = "الموردين", Icon = "🤝" },
        new() { Name = "الذمم", Icon = "👷" }
    };

    private string GetNestedRoleIcon(string name) =>
        nestedOptionsList.FirstOrDefault(x => x.Name == name)?.Icon ?? "🧑‍💼";

    private List<string> dealSideList = new()
    {
        "عملاء بضريبة",
        "عملاء جملة",
        "عملاء قطاعي",
        "موردين بضريبة"
    };

    private void OnTaxEnabledChanged(ChangeEventArgs e)
    {
        if (e.Value is bool val)
        {
            customerData.TaxEnabled = val;
            if (!val) isTaxDropdownPopupOpen = false;
        }
    }

    private bool IsAnyPopupOpen() =>
        isBranchPopupOpen ||
        isNestedPopupOpen ||
        isCurrencyPopupOpen ||
        isLedgerPopupOpen ||
        isDealTypePopupOpen ||
        isDealSidePopupOpen ||
        isCompPopupOpen ||
        isDiscountTiersPopupOpen ||
        isCreditCalcOpen ||
        isTaxDropdownPopupOpen ||
        isCountryPopupOpen ||
        isRegionPopupOpen ||
        isModalBranchPopupOpen ||
        isModalParentGroupPopupOpen ||
        isModalShowWithPopupOpen ||
        isDealSideNestedPopupOpen ||
        isDealSideCurrencyPopupOpen ||
        isDealSideLedgerPopupOpen;

    private void ToggleBranchPopup() { bool wasOpen = isBranchPopupOpen; CloseAllPopups(); isBranchPopupOpen = !wasOpen; }
    private void ToggleNestedPopup() { bool wasOpen = isNestedPopupOpen; CloseAllPopups(); isNestedPopupOpen = !wasOpen; }
    private void ToggleCurrencyPopup() { bool wasOpen = isCurrencyPopupOpen; CloseAllPopups(); isCurrencyPopupOpen = !wasOpen; }
    private void ToggleLedgerPopup() { bool wasOpen = isLedgerPopupOpen; CloseAllPopups(); isLedgerPopupOpen = !wasOpen; }
    private void ToggleDealTypePopup() { bool wasOpen = isDealTypePopupOpen; CloseAllPopups(); isDealTypePopupOpen = !wasOpen; }
    private void ToggleDealSidePopup() { bool wasOpen = isDealSidePopupOpen; CloseAllPopups(); isDealSidePopupOpen = !wasOpen; }
    private void ToggleCompPopup() { bool wasOpen = isCompPopupOpen; CloseAllPopups(); isCompPopupOpen = !wasOpen; }
    private void ToggleDiscountTiersPopup() { bool wasOpen = isDiscountTiersPopupOpen; CloseAllPopups(); isDiscountTiersPopupOpen = !wasOpen; }
    private void ToggleCreditCalc() { bool wasOpen = isCreditCalcOpen; CloseAllPopups(); isCreditCalcOpen = !wasOpen; }
    private void ToggleTaxDropdownPopup()
    {
        if (!customerData.TaxEnabled) return;
        bool wasOpen = isTaxDropdownPopupOpen;
        CloseAllPopups();
        isTaxDropdownPopupOpen = !wasOpen;
    }
    private void ToggleCountryPopup() { bool wasOpen = isCountryPopupOpen; CloseAllPopups(); isCountryPopupOpen = !wasOpen; }
    private void ToggleRegionPopup() { bool wasOpen = isRegionPopupOpen; CloseAllPopups(); isRegionPopupOpen = !wasOpen; }

    private void CloseAllPopups()
    {
        isBranchPopupOpen = false;
        isNestedPopupOpen = false;
        isCurrencyPopupOpen = false;
        isLedgerPopupOpen = false;
        isDealTypePopupOpen = false;
        isDealSidePopupOpen = false;
        isCompPopupOpen = false;
        isDiscountTiersPopupOpen = false;
        isCreditCalcOpen = false;
        isTaxDropdownPopupOpen = false;
        isCountryPopupOpen = false;
        isRegionPopupOpen = false;
        CloseModalPopups();
        CloseDealSidePopups();
    }

    private void CloseModalPopups()
    {
        isModalBranchPopupOpen = false;
        isModalParentGroupPopupOpen = false;
        isModalShowWithPopupOpen = false;
    }

    private void CloseDealSidePopups()
    {
        isDealSideNestedPopupOpen = false;
        isDealSideCurrencyPopupOpen = false;
        isDealSideLedgerPopupOpen = false;
    }

    private void ToggleModalBranchPopup() { bool o = isModalBranchPopupOpen; CloseModalPopups(); isModalBranchPopupOpen = !o; }
    private void ToggleModalParentGroupPopup() { bool o = isModalParentGroupPopupOpen; CloseModalPopups(); isModalParentGroupPopupOpen = !o; }
    private void ToggleModalShowWithPopup() { bool o = isModalShowWithPopupOpen; CloseModalPopups(); isModalShowWithPopupOpen = !o; }

    private void ToggleDealSideNestedPopup() { bool o = isDealSideNestedPopupOpen; CloseDealSidePopups(); isDealSideNestedPopupOpen = !o; }
    private void ToggleDealSideCurrencyPopup() { bool o = isDealSideCurrencyPopupOpen; CloseDealSidePopups(); isDealSideCurrencyPopupOpen = !o; }
    private void ToggleDealSideLedgerPopup() { bool o = isDealSideLedgerPopupOpen; CloseDealSidePopups(); isDealSideLedgerPopupOpen = !o; }

    private void OpenNestedModal()
    {
        CloseAllPopups();
        newNestedModel = new NestedGroupModel
        {
            Code = (mockNestedTree.Count + 1).ToString(),
            Branch = customerData.Branch ?? "الفرع الرئيسي",
            ParentGroup = customerData.NestedWithin ?? "",
            ShowWith = "الكل",
            IsActive = true
        };
        isNestedModalOpen = true;
    }

    private void CloseNestedModal()
    {
        isNestedModalOpen = false;
        CloseModalPopups();
    }

    private void SaveNestedModal()
    {
        if (!string.IsNullOrWhiteSpace(newNestedModel.Name))
        {
            if (string.IsNullOrWhiteSpace(newNestedModel.ParentGroup))
            {
                mockNestedTree.Add(new NestedTreeNodeModel
                {
                    Name = newNestedModel.Name,
                    Level = 0,
                    IsExpanded = true
                });
            }
            else
            {
                var parent = FindTreeNode(mockNestedTree, newNestedModel.ParentGroup);
                if (parent != null)
                {
                    parent.Children.Add(new NestedTreeNodeModel
                    {
                        Name = newNestedModel.Name,
                        Level = parent.Level + 1,
                        IsExpanded = true
                    });
                    parent.IsExpanded = true;
                }
                else
                {
                    mockNestedTree.Add(new NestedTreeNodeModel
                    {
                        Name = newNestedModel.Name,
                        Level = 0,
                        IsExpanded = true
                    });
                }
            }
            customerData.NestedWithin = newNestedModel.Name;
        }
        CloseNestedModal();
    }

    private NestedTreeNodeModel? FindTreeNode(List<NestedTreeNodeModel> nodes, string name)
    {
        foreach (var node in nodes)
        {
            if (node.Name == name) return node;
            var found = FindTreeNode(node.Children, name);
            if (found != null) return found;
        }
        return null;
    }

    private void OpenDealSideModal()
    {
        CloseAllPopups();
        newDealSideModel = new DealSideModel
        {
            Name = "",
            NestedUnder = "الكل",
            IsActive = true,
            DefaultCurrency = customerData.Currency ?? "EGP",
            LedgerAccount = ""
        };
        isDealSideModalOpen = true;
    }

    private void CloseDealSideModal()
    {
        isDealSideModalOpen = false;
        CloseDealSidePopups();
    }

    private void SaveDealSideModal()
    {
        if (!string.IsNullOrWhiteSpace(newDealSideModel.Name))
        {
            if (!dealSideList.Contains(newDealSideModel.Name))
            {
                dealSideList.Add(newDealSideModel.Name);
            }
            customerData.DealSide = newDealSideModel.Name;
        }
        CloseDealSideModal();
    }

    public class DiscountTierItem
    {
        public string Name { get; set; } = "";
        public decimal Rate { get; set; } = 0;
    }

    private List<DiscountTierItem> discountTiersList = new()
    {
        new() { Name = "خصم عملاء الفئة أ (5%)", Rate = 5 },
        new() { Name = "خصم نقدي تجاري (2%)", Rate = 2 },
        new() { Name = "خصم كميات خاص", Rate = 0 }
    };

    private void SelectDiscountTier(string tierName)
    {
        customerData.DiscountTier = tierName;
        isDiscountTiersPopupOpen = false;
    }

    private void RequestDeleteDiscountTier(DiscountTierItem tier)
    {
        tierPendingDelete = tier;
        isConfirmDeleteModalOpen = true;
    }

    private void ConfirmDeleteTier()
    {
        if (tierPendingDelete != null)
        {

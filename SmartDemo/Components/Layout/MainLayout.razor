@inherits LayoutComponentBase
@using SmartDemo.Services
@inject NavigationManager NavigationManager
@inject DxThemesService ThemesService

<div class="page">
    <!-- Topbar Navigation Bar -->
    <div class="topbar-container" style="background-color: #b33600; color: white; display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem; direction: rtl; font-size:11px;position:fixed;width:100%;z-index:1000000;">

        <!-- Right side / Main Menu Items -->
        <div class="topbar-menu" style="display: flex; gap: 1.5rem; align-items: center; list-style: none; margin: 0; padding: 0;">
            <a href="/addItem" style="color: white; text-decoration: none;">الاصناف</a>
            <a href="/AddCustomer" style="color: white; text-decoration: none;">العملاء</a>
            <a href="/AddSupplier" style="color: white; text-decoration: none;">الموردين</a>
            <a href="/AddCompany" style="color: white; text-decoration: none;">الشركة</a>
            <a href="/ChartAccounts" style="color: white; text-decoration: none;">شجرة الحسابات</a>
            <a href="/Expense" style="color: white; text-decoration: none;"> المصروفات</a>
            <a href="/Recette" style="color: white; text-decoration: none;"> الايرادات</a>

        </div>

        <!-- Left side / Icons (e.g., Notifications) -->
        <div class="topbar-actions" style="display: flex; align-items: center; gap: 1rem;">
            <button class="btn btn-link text-white p-0" style="text-decoration: none; border: none; background: transparent;">
                <i class="bi bi-bell" style="font-size: 1.25rem;"></i>
            </button>
        </div>
    </div>

    <!-- Page Content -->
    <div class="w-100" style="margin-top:41px;">
        @Body
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = UrlGenerator.ToggleSidebarName)]
    public bool ToggledSidebar { get; set; }
}
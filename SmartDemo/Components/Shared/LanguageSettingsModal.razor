        font-size: 0.88rem;
        cursor: pointer;
    }

    .btn-lang-cancel {
        background-color: #007bff;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 6px 36px;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
    }
</style>
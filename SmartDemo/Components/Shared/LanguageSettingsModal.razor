        font-weight: 600;
    }

    .btn-modal-close {
        border: none;
        background: transparent;
        font-size: 1.1rem;
        color: #6c757d;
        cursor: pointer;
        line-height: 1;
        padding: 0;
    }

    .languages-prompt-text {
        font-size: 0.84rem;
        color: #333333;
        text-align: center;
        margin-bottom: 16px;
    }

    .languages-frame-box {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: stretch;
        gap: 14px;
        margin-bottom: 20px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 10px;
        background-color: #ffffff;
    }

    .languages-items-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
        overflow-y: auto;
        max-height: 220px;
        padding: 4px;
    }

    .language-item-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        font-size: 0.88rem;
        color: #212529;
    }

    .lang-flag {
        font-size: 1.25rem;
        line-height: 1;
        width: 26px;
        text-align: center;
        display: inline-block;
    }

    .language-item-row .chk-box {
        width: 16px;
        height: 16px;
        cursor: pointer;
        margin: 0;
    }

    .lang-title {
        width: fit-content;
        text-align: right;
        font-weight: 500;
    }

    .lang-sidebar-banner {
        width: 42px;
        background-color: #2196f3;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 3px;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-size: 0.82rem;
        font-weight: bold;
        letter-spacing: 0.5px;
        padding: 12px 0;
        user-select: none;
        flex-shrink: 0;
    }

    .languages-modal-footer {
        display: flex;
        flex-direction: row;
        gap: 12px;

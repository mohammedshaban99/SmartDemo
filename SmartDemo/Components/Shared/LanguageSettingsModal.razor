@if (IsOpen)
{
    <div class="modal-backdrop-blur">
        <div class="languages-modal-dialog" dir="rtl">
            <div class="languages-modal-header">
                <span class="languages-modal-title">اللغات المستخدمة</span>
                <button type="button" class="btn-modal-close" @onclick="Close">✕</button>
            </div>
            <div class="languages-modal-body">
                <p class="languages-prompt-text">من فضلك حدد اللغات التي تستخدمها في التعامل مع البرنامج</p>
                <div class="languages-frame-box">
                    <div class="languages-items-column">
                        @foreach (var lang in Languages)
                        {
                            <div class="language-item-row">
                                <span class="lang-flag">@lang.FlagEmoji</span>
                                <input type="checkbox" class="chk-box" @checked="lang.IsSelected" @onchange="(e) => lang.IsSelected = (bool)(e.Value ?? false)" />
                                <span class="lang-title">@lang.Name</span>
                            </div>
                        }
                    </div>
                    <div class="lang-sidebar-banner">
                        <span>اللغات المستخدمة</span>
                    </div>
                </div>
            </div>
            <div class="languages-modal-footer">
                <button type="button" class="btn-lang-submit" @onclick="Save">موافق</button>
                <button type="button" class="btn-lang-cancel" @onclick="Close">إغلاق</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public List<LanguageItem> Languages { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }

    public class LanguageItem
    {
        public string Name { get; set; } = "";
        public string FlagEmoji { get; set; } = "";
        public bool IsSelected { get; set; }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }

    private async Task Save()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }
        await Close();
    }
}

<style>
    .modal-backdrop-blur {
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;

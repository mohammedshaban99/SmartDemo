    }

    .languages-modal-dialog {
        background: #ffffff;
        border-radius: 6px;
        width: 390px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        padding: 16px 20px;
        display: flex;
        flex-direction: column;
        box-sizing: border-box;
        z-index: 4001;
    }

    .languages-modal-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .languages-modal-title {
        font-size: 0.9rem;
